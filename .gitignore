# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# Editors' per-project settings.
.cursor/

# Working notes, written while a branch is being prepared.
.pr-body.md

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/packages/*/build/
/coverage/

# The project's own record of how flutter create made it. Removed: it is not
# read by run or build, and flutter create recreates it on demand.
.metadata

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# MSVC object files (scratch builds of the Windows runner)
*.obj

# npm dependencies of the extension host code generators.
tool/exthost_codegen/node_modules/
