  "grammars": [
    {
      "extension": "typescript-basics",
      "language": "typescript",
      "scopeName": "source.ts",
      "path": "grammars/typescript-basics/syntaxes/TypeScript.tmLanguage.json",
      "tokenTypes": {
        "punctuation.definition.template-expression": "other",
        "entity.name.type.instance.jsdoc": "other",
        "entity.name.function.tagged-template": "other",
        "meta.import string.quoted": "other",
        "variable.other.jsdoc": "other"
      },
      "unbalancedBracketScopes": [
        "keyword.operator.relational",
        "storage.type.function.arrow",
        "keyword.operator.bitwise.shift",
        "meta.brace.angle",
        "punctuation.definition.tag",
        "keyword.operator.assignment.compound.bitwise.ts"
      ]
    },
    {
      "extension": "typescript-basics",
      "language": "typescriptreact",
      "scopeName": "source.tsx",
      "path": "grammars/typescript-basics/syntaxes/TypeScriptReact.tmLanguage.json",
      "embeddedLanguages": {
        "meta.tag.tsx": "jsx-tags",
        "meta.tag.without-attributes.tsx": "jsx-tags",
        "meta.tag.attributes.tsx": "typescriptreact",
        "meta.embedded.expression.tsx": "typescriptreact"
      },
      "tokenTypes": {
        "punctuation.definition.template-expression": "other",
        "entity.name.type.instance.jsdoc": "other",
        "entity.name.function.tagged-template": "other",
        "meta.import string.quoted": "other",
        "variable.other.jsdoc": "other"
      },
      "unbalancedBracketScopes": [
        "keyword.operator.relational",
        "storage.type.function.arrow",
        "keyword.operator.bitwise.shift",
        "punctuation.definition.tag",
        "keyword.operator.assignment.compound.bitwise.ts"
      ]
    },
    {
      "extension": "typescript-basics",
      "scopeName": "documentation.injection.ts",
      "path": "grammars/typescript-basics/syntaxes/jsdoc.ts.injection.tmLanguage.json",
      "injectTo": [
        "source.ts",
        "source.tsx"
      ]
    },
    {
      "extension": "typescript-basics",
      "scopeName": "documentation.injection.js.jsx",
      "path": "grammars/typescript-basics/syntaxes/jsdoc.js.injection.tmLanguage.json",
      "injectTo": [
        "source.js",
        "source.js.jsx"
      ]
    }
  ],
  "languages": [
    {
      "extension": "typescript-basics",
      "id": "typescript",
      "aliases": [
        "TypeScript",
        "ts",
        "typescript"
      ],
      "extensions": [
        ".ts",
        ".cts",
        ".mts"
      ],
      "firstLine": "^#!.*\\b(deno|bun|ts-node)\\b",
      "configuration": "grammars/typescript-basics/language-configuration.json"
    },
    {
      "extension": "typescript-basics",
      "id": "typescriptreact",
      "aliases": [
        "TypeScript JSX",
        "TypeScript React",
        "tsx"
      ],
      "extensions": [
        ".tsx"
      ],
      "configuration": "grammars/typescript-basics/language-configuration.json"
    },
    {
      "extension": "javascript",
      "id": "jsx-tags",
      "aliases": [],
