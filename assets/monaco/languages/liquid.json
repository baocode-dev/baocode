    },
    "tokenizer": {
      "root": [
        [
          {
            "$regex": "\\{\\%\\s*comment\\s*\\%\\}",
            "$flags": ""
          },
          "comment.start.liquid",
          "@comment"
        ],
        [
          {
            "$regex": "\\{\\{",
            "$flags": ""
          },
          {
            "token": "@rematch",
            "switchTo": "@liquidState.root"
          }
        ],
        [
          {
            "$regex": "\\{\\%",
            "$flags": ""
          },
          {
            "token": "@rematch",
            "switchTo": "@liquidState.root"
          }
        ],
        [
          {
            "$regex": "(<)([\\w\\-]+)(\\/>)",
            "$flags": ""
          },
          [
            "delimiter.html",
            "tag.html",
            "delimiter.html"
          ]
        ],
        [
          {
            "$regex": "(<)([:\\w]+)",
            "$flags": ""
          },
          [
            "delimiter.html",
            {
              "token": "tag.html",
              "next": "@otherTag"
            }
          ]
        ],
        [
          {
            "$regex": "(<\\/)([\\w\\-]+)",
            "$flags": ""
          },
          [
            "delimiter.html",
            {
              "token": "tag.html",
              "next": "@otherTag"
            }
          ]
        ],
        [
          {
            "$regex": "<",
            "$flags": ""
          },
          "delimiter.html"
        ],
        [
          {
            "$regex": "\\{",
            "$flags": ""
          },
          "delimiter.html"
        ],
        [
          {
            "$regex": "[^<{]+",
            "$flags": ""
          }
        ]
      ],
      "comment": [
        [
          {
            "$regex": "\\{\\%\\s*endcomment\\s*\\%\\}",
            "$flags": ""
          },
          "comment.end.liquid",
          "@pop"
        ],
        [
          {
            "$regex": ".",
            "$flags": ""
          },
          "comment.content.liquid"
        ]
      ],
      "otherTag": [
        [
          {
            "$regex": "\\{\\{",
            "$flags": ""
          },
          {
            "token": "@rematch",
            "switchTo": "@liquidState.otherTag"
          }
        ],
        [
          {
            "$regex": "\\{\\%",
            "$flags": ""
          },
          {
            "token": "@rematch",
            "switchTo": "@liquidState.otherTag"
          }
        ],
        [
          {
            "$regex": "\\/?>",
            "$flags": ""
          },
          "delimiter.html",
          "@pop"
        ],
        [
          {
            "$regex": "\"([^\"]*)\"",
            "$flags": ""
          },
          "attribute.value"
        ],
        [
          {
            "$regex": "'([^']*)'",
            "$flags": ""
          },
          "attribute.value"
        ],
        [
          {
            "$regex": "[\\w\\-]+",
            "$flags": ""
          },
          "attribute.name"
        ],
        [
          {
            "$regex": "=",
            "$flags": ""
          },
          "delimiter"
        ],
        [
          {
            "$regex": "[ \\t\\r\\n]+",
            "$flags": ""
          }
        ]
      ],
      "liquidState": [
        [
          {
            "$regex": "\\{\\{",
            "$flags": ""
          },
          "delimiter.output.liquid"
        ],
        [
          {
            "$regex": "\\}\\}",
            "$flags": ""
          },
          {
            "token": "delimiter.output.liquid",
            "switchTo": "@$S2.$S3"
          }
        ],
        [
          {
            "$regex": "\\{\\%",
            "$flags": ""
          },
          "delimiter.tag.liquid"
        ],
        [
          {
            "$regex": "raw\\s*\\%\\}",
            "$flags": ""
          },
          "delimiter.tag.liquid",
          "@liquidRaw"
        ],
        [
          {
            "$regex": "\\%\\}",
            "$flags": ""
          },
          {
            "token": "delimiter.tag.liquid",
            "switchTo": "@$S2.$S3"
          }
        ],
        {
          "include": "liquidRoot"
        }
      ],
      "liquidRaw": [
        [
          {
            "$regex": "^(?!\\{\\%\\s*endraw\\s*\\%\\}).+",
            "$flags": ""
          }
        ],
        [
          {
            "$regex": "\\{\\%",
            "$flags": ""
          },
          "delimiter.tag.liquid"
        ],
        [
          {
            "$regex": "@identifier",
            "$flags": ""
          }
        ],
        [
          {
            "$regex": "\\%\\}",
            "$flags": ""
          },
          {
            "token": "delimiter.tag.liquid",
            "next": "@root"
          }
        ]
      ],
      "liquidRoot": [
        [
          {
            "$regex": "\\d+(\\.\\d+)?",
            "$flags": ""
          },
          "number.liquid"
        ],
        [
          {
            "$regex": "\"[^\"]*\"",
            "$flags": ""
          },
          "string.liquid"
        ],
        [
          {
            "$regex": "'[^']*'",
            "$flags": ""
          },
          "string.liquid"
        ],
        [
          {
            "$regex": "\\s+",
            "$flags": ""
          }
        ],
        [
          {
            "$regex": "@symbol",
            "$flags": ""
          },
          {
            "cases": {
              "@operators": "operator.liquid",
              "@default": ""
            }
          }
        ],
        [
          {
            "$regex": "\\.",
            "$flags": ""
          }
        ],
        [
          {
            "$regex": "@identifier",
            "$flags": ""
          },
          {
            "cases": {
              "@constants": "keyword.liquid",
              "@builtinFilters": "predefined.liquid",
              "@builtinTags": "predefined.liquid",
              "@default": "variable.liquid"
            }
          }
        ],
        [
          {
            "$regex": "[^}|%]",
            "$flags": ""
          },
          "variable.liquid"
        ]
      ]
    }
  },
  "configuration": {
    "wordPattern": {
      "$regex": "(-?\\d*\\.\\d\\w*)|([^\\`\\~\\!\\@\\$\\^\\&\\*\\(\\)\\=\\+\\[\\{\\]\\}\\\\\\|\\;\\:\\'\\\"\\,\\.\\<\\>\\/\\s]+)",
      "$flags": "g"
    },
    "brackets": [
