    "symbols": {
      "$regex": "[=><!~?:&|+\\-*\\/\\^%]+",
      "$flags": ""
    },
    "escapes": {
      "$regex": "\\\\(?:[abfnrtv\\\\\"']|x[0-9A-Fa-f]{1,4}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})",
      "$flags": ""
    },
    "digits": {
      "$regex": "\\d+(_+\\d+)*",
      "$flags": ""
    },
    "octaldigits": {
      "$regex": "[0-7]+(_+[0-7]+)*",
      "$flags": ""
    },
    "binarydigits": {
      "$regex": "[0-1]+(_+[0-1]+)*",
      "$flags": ""
    },
    "hexdigits": {
      "$regex": "[[0-9a-fA-F]+(_+[0-9a-fA-F]+)*",
      "$flags": ""
    },
    "tokenizer": {
      "root": [
        [
          {
            "$regex": "[A-Z][\\w\\$]*",
            "$flags": ""
          },
          "type.identifier"
        ],
        [
          {
            "$regex": "[a-zA-Z_$][\\w$]*",
            "$flags": ""
          },
          {
            "cases": {
              "@keywords": {
                "token": "keyword.$0"
              },
              "@default": "identifier"
            }
          }
        ],
        {
          "include": "@whitespace"
        },
        [
          {
            "$regex": "[{}()\\[\\]]",
            "$flags": ""
          },
          "@brackets"
        ],
        [
          {
            "$regex": "[<>](?!@symbols)",
            "$flags": ""
          },
          "@brackets"
        ],
        [
          {
            "$regex": "@symbols",
            "$flags": ""
          },
          {
            "cases": {
              "@operators": "delimiter",
              "@default": ""
            }
          }
        ],
        [
          {
            "$regex": "@\\s*[a-zA-Z_\\$][\\w\\$]*",
            "$flags": ""
          },
          "annotation"
        ],
        [
          {
            "$regex": "(@digits)[eE]([\\-+]?(@digits))?[fF]?",
            "$flags": ""
          },
          "number.float"
        ],
        [
          {
            "$regex": "(@digits)?\\.(@digits)([eE][\\-+]?(@digits))?[fF]?",
            "$flags": ""
          },
          "number.float"
        ],
        [
          {
            "$regex": "0[xX](@hexdigits)[uU]?L?",
            "$flags": ""
          },
          "number.hex"
        ],
        [
          {
            "$regex": "0[bB](@binarydigits)[uU]?L?",
            "$flags": ""
          },
          "number.binary"
        ],
        [
          {
            "$regex": "(@digits)[fF]",
            "$flags": ""
          },
          "number.float"
        ],
        [
          {
            "$regex": "(@digits)[uU]?L?",
            "$flags": ""
          },
          "number"
        ],
        [
          {
            "$regex": "[;,.]",
            "$flags": ""
          },
          "delimiter"
        ],
        [
          {
            "$regex": "\"([^\"\\\\]|\\\\.)*$",
            "$flags": ""
          },
          "string.invalid"
        ],
        [
          {
            "$regex": "\"\"\"",
            "$flags": ""
          },
          "string",
          "@multistring"
        ],
        [
          {
            "$regex": "\"",
            "$flags": ""
          },
          "string",
          "@string"
        ],
        [
          {
            "$regex": "'[^\\\\']'",
            "$flags": ""
          },
          "string"
        ],
        [
          {
            "$regex": "(')(@escapes)(')",
            "$flags": ""
          },
          [
            "string",
            "string.escape",
            "string"
          ]
        ],
        [
          {
            "$regex": "'",
            "$flags": ""
          },
          "string.invalid"
        ]
      ],
      "whitespace": [
        [
          {
            "$regex": "[ \\t\\r\\n]+",
            "$flags": ""
          },
          ""
        ],
        [
          {
            "$regex": "\\/\\*\\*(?!\\/)",
            "$flags": ""
          },
          "comment.doc",
          "@javadoc"
        ],
        [
          {
            "$regex": "\\/\\*",
            "$flags": ""
          },
          "comment",
          "@comment"
        ],
        [
          {
            "$regex": "\\/\\/.*$",
            "$flags": ""
          },
          "comment"
        ]
      ],
      "comment": [
        [
          {
            "$regex": "[^\\/*]+",
            "$flags": ""
          },
          "comment"
        ],
        [
          {
            "$regex": "\\/\\*",
            "$flags": ""
          },
          "comment",
          "@comment"
        ],
        [
          {
            "$regex": "\\*\\/",
            "$flags": ""
          },
          "comment",
          "@pop"
        ],
        [
          {
            "$regex": "[\\/*]",
            "$flags": ""
          },
          "comment"
        ]
      ],
      "javadoc": [
        [
          {
            "$regex": "[^\\/*]+",
            "$flags": ""
          },
          "comment.doc"
        ],
        [
          {
            "$regex": "\\/\\*",
            "$flags": ""
          },
          "comment.doc",
          "@push"
        ],
        [
          {
            "$regex": "\\/\\*",
            "$flags": ""
          },
          "comment.doc.invalid"
        ],
        [
          {
            "$regex": "\\*\\/",
            "$flags": ""
          },
          "comment.doc",
          "@pop"
        ],
        [
          {
            "$regex": "[\\/*]",
            "$flags": ""
          },
          "comment.doc"
        ]
      ],
      "string": [
        [
          {
            "$regex": "[^\\\\\"]+",
            "$flags": ""
          },
          "string"
        ],
        [
          {
            "$regex": "@escapes",
            "$flags": ""
          },
          "string.escape"
        ],
        [
          {
            "$regex": "\\\\.",
            "$flags": ""
          },
          "string.escape.invalid"
        ],
        [
          {
            "$regex": "\"",
            "$flags": ""
          },
          "string",
          "@pop"
        ]
      ],
      "multistring": [
        [
          {
            "$regex": "[^\\\\\"]+",
            "$flags": ""
          },
          "string"
        ],
        [
          {
            "$regex": "@escapes",
            "$flags": ""
          },
          "string.escape"
        ],
        [
          {
            "$regex": "\\\\.",
            "$flags": ""
          },
          "string.escape.invalid"
        ],
        [
          {
            "$regex": "\"\"\"",
            "$flags": ""
          },
          "string",
          "@pop"
        ],
        [
          {
            "$regex": ".",
            "$flags": ""
          },
          "string"
        ]
      ]
    }
  },
  "configuration": {
    "wordPattern": {
      "$regex": "(-?\\d*\\.\\d\\w*)|([^\\`\\~\\!\\#\\%\\^\\&\\*\\(\\)\\-\\=\\+\\[\\{\\]\\}\\\\\\|\\;\\:\\'\\\"\\,\\.\\<\\>\\/\\?\\s]+)",
      "$flags": "g"
    },
    "comments": {
      "lineComment": "//",
      "blockComment": [
        "/*",
        "*/"
      ]
    },
    "brackets": [
      [
        "{",
        "}"
      ],
      [
        "[",
        "]"
      ],
      [
        "(",
        ")"
      ]
    ],
    "autoClosingPairs": [
      {
        "open": "{",
        "close": "}"
      },
      {
        "open": "[",
        "close": "]"
      },
      {
        "open": "(",
        "close": ")"
      },
      {
        "open": "\"",
        "close": "\""
      },
      {
        "open": "'",
        "close": "'"
      }
    ],
    "surroundingPairs": [
      {
        "open": "{",
        "close": "}"
      },
      {
        "open": "[",
        "close": "]"
      },
      {
        "open": "(",
        "close": ")"
      },
      {
        "open": "\"",
        "close": "\""
      },
      {
        "open": "'",
        "close": "'"
      },
      {
        "open": "<",
        "close": ">"
      }
    ],
    "folding": {
      "markers": {
        "start": {
          "$regex": "^\\s*\\/\\/\\s*(?:(?:#?region\\b)|(?:<editor-fold\\b))",
          "$flags": ""
        },
        "end": {
          "$regex": "^\\s*\\/\\/\\s*(?:(?:#?endregion\\b)|(?:<\\/editor-fold>))",
          "$flags": ""
        }
      }
    }
  }
