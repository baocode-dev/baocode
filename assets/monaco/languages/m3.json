    "delimiters": [
      "|",
      "..",
      "=>",
      ",",
      ";",
      ":="
    ],
    "symbols": {
      "$regex": "[>=<#.,:;+\\-*/&^]+",
      "$flags": ""
    },
    "escapes": {
      "$regex": "\\\\(?:[\\\\fnrt\"']|[0-7]{3})",
      "$flags": ""
    },
    "tokenizer": {
      "root": [
        [
          {
            "$regex": "_\\w*",
            "$flags": ""
          },
          "invalid"
        ],
        [
          {
            "$regex": "[a-zA-Z][a-zA-Z0-9_]*",
            "$flags": ""
          },
          {
            "cases": {
              "@keywords": {
                "token": "keyword.$0"
              },
              "@reservedConstNames": {
                "token": "constant.reserved.$0"
              },
              "@reservedTypeNames": {
                "token": "type.reserved.$0"
              },
              "@default": "identifier"
            }
          }
        ],
        {
          "include": "@whitespace"
        },
        [
          {
            "$regex": "[{}()\\[\\]]",
            "$flags": ""
          },
          "@brackets"
        ],
        [
          {
            "$regex": "[0-9]+\\.[0-9]+(?:[DdEeXx][\\+\\-]?[0-9]+)?",
            "$flags": ""
          },
          "number.float"
        ],
        [
          {
            "$regex": "[0-9]+(?:\\_[0-9a-fA-F]+)?L?",
            "$flags": ""
          },
          "number"
        ],
        [
          {
            "$regex": "@symbols",
            "$flags": ""
          },
          {
            "cases": {
              "@operators": "operators",
              "@relations": "operators",
              "@delimiters": "delimiter",
              "@default": "invalid"
            }
          }
        ],
        [
          {
            "$regex": "'[^\\\\']'",
            "$flags": ""
          },
          "string.char"
        ],
        [
          {
            "$regex": "(')(@escapes)(')",
            "$flags": ""
          },
          [
            "string.char",
            "string.escape",
            "string.char"
          ]
        ],
        [
          {
            "$regex": "'",
            "$flags": ""
          },
          "invalid"
        ],
        [
          {
            "$regex": "\"([^\"\\\\]|\\\\.)*$",
            "$flags": ""
          },
          "invalid"
        ],
        [
          {
            "$regex": "\"",
            "$flags": ""
          },
          "string.text",
          "@text"
        ]
      ],
      "text": [
        [
          {
            "$regex": "[^\\\\\"]+",
            "$flags": ""
          },
          "string.text"
        ],
        [
          {
            "$regex": "@escapes",
            "$flags": ""
          },
          "string.escape"
        ],
        [
          {
            "$regex": "\\\\.",
            "$flags": ""
          },
          "invalid"
        ],
        [
          {
            "$regex": "\"",
            "$flags": ""
          },
          "string.text",
          "@pop"
        ]
      ],
      "comment": [
        [
          {
            "$regex": "\\(\\*",
            "$flags": ""
          },
          "comment",
          "@push"
        ],
        [
          {
            "$regex": "\\*\\)",
            "$flags": ""
          },
          "comment",
          "@pop"
        ],
        [
          {
            "$regex": ".",
            "$flags": ""
          },
          "comment"
        ]
      ],
      "pragma": [
        [
          {
            "$regex": "<\\*",
            "$flags": ""
          },
          "keyword.pragma",
          "@push"
        ],
        [
          {
            "$regex": "\\*>",
            "$flags": ""
          },
          "keyword.pragma",
          "@pop"
        ],
        [
          {
            "$regex": ".",
            "$flags": ""
          },
          "keyword.pragma"
        ]
      ],
      "whitespace": [
        [
          {
            "$regex": "[ \\t\\r\\n]+",
            "$flags": ""
          },
          "white"
        ],
        [
          {
            "$regex": "\\(\\*",
            "$flags": ""
          },
          "comment",
          "@comment"
        ],
        [
          {
            "$regex": "<\\*",
            "$flags": ""
          },
          "keyword.pragma",
          "@pragma"
        ]
      ]
    }
  },
  "configuration": {
    "comments": {
      "blockComment": [
        "(*",
        "*)"
      ]
    },
    "brackets": [
      [
        "{",
        "}"
      ],
      [
        "[",
        "]"
      ],
      [
        "(",
        ")"
      ]
    ],
    "autoClosingPairs": [
      {
        "open": "[",
        "close": "]"
      },
      {
        "open": "{",
        "close": "}"
      },
      {
        "open": "(",
        "close": ")"
      },
      {
        "open": "(*",
        "close": "*)"
      },
      {
        "open": "<*",
        "close": "*>"
      },
      {
        "open": "'",
        "close": "'",
        "notIn": [
          "string",
          "comment"
        ]
      },
      {
        "open": "\"",
        "close": "\"",
        "notIn": [
          "string",
          "comment"
        ]
      }
    ]
  }
