    "symbols": {
      "$regex": "[=><!~?;\\.,:&|+\\-*\\/\\^%]+",
      "$flags": ""
    },
    "integersuffix": {
      "$regex": "U?[DI%L&S@]?",
      "$flags": ""
    },
    "floatsuffix": {
      "$regex": "[R#F!]?",
      "$flags": ""
    },
    "tokenizer": {
      "root": [
        {
          "include": "@whitespace"
        },
        [
          {
            "$regex": "next(?!\\w)",
            "$flags": ""
          },
          {
            "token": "keyword.tag-for"
          }
        ],
        [
          {
            "$regex": "loop(?!\\w)",
            "$flags": ""
          },
          {
            "token": "keyword.tag-do"
          }
        ],
        [
          {
            "$regex": "end\\s+(?!for|do)(addhandler|class|enum|event|function|get|if|interface|module|namespace|operator|property|raiseevent|removehandler|select|set|structure|sub|synclock|try|while|with|using)",
            "$flags": ""
          },
          {
            "token": "keyword.tag-$1"
          }
        ],
        [
          {
            "$regex": "[a-zA-Z_]\\w*",
            "$flags": ""
          },
          {
            "cases": {
              "@tagwords": {
                "token": "keyword.tag-$0"
              },
              "@keywords": {
                "token": "keyword.$0"
              },
              "@default": "identifier"
            }
          }
        ],
        [
          {
            "$regex": "^\\s*#\\w+",
            "$flags": ""
          },
          "keyword"
        ],
        [
          {
            "$regex": "\\d*\\d+e([\\-+]?\\d+)?(@floatsuffix)",
            "$flags": ""
          },
          "number.float"
        ],
        [
          {
            "$regex": "\\d*\\.\\d+(e[\\-+]?\\d+)?(@floatsuffix)",
            "$flags": ""
          },
          "number.float"
        ],
        [
          {
            "$regex": "&H[0-9a-f]+(@integersuffix)",
            "$flags": ""
          },
          "number.hex"
        ],
        [
          {
            "$regex": "&0[0-7]+(@integersuffix)",
            "$flags": ""
          },
          "number.octal"
        ],
        [
          {
            "$regex": "\\d+(@integersuffix)",
            "$flags": ""
          },
          "number"
        ],
        [
          {
            "$regex": "#.*#",
            "$flags": ""
          },
          "number"
        ],
        [
          {
            "$regex": "[{}()\\[\\]]",
            "$flags": ""
          },
          "@brackets"
        ],
        [
          {
            "$regex": "@symbols",
            "$flags": ""
          },
          "delimiter"
        ],
        [
          {
            "$regex": "[\"\\u201c\\u201d]",
            "$flags": ""
          },
          {
            "token": "string.quote",
            "next": "@string"
          }
        ]
      ],
      "whitespace": [
        [
          {
            "$regex": "[ \\t\\r\\n]+",
            "$flags": ""
          },
          ""
        ],
        [
          {
            "$regex": "(\\'|REM(?!\\w)).*$",
            "$flags": ""
          },
          "comment"
        ]
      ],
      "string": [
        [
          {
            "$regex": "[^\"\\u201c\\u201d]+",
            "$flags": ""
          },
          "string"
        ],
        [
          {
            "$regex": "[\"\\u201c\\u201d]{2}",
            "$flags": ""
          },
          "string.escape"
        ],
        [
          {
            "$regex": "[\"\\u201c\\u201d]C?",
            "$flags": ""
          },
          {
            "token": "string.quote",
            "next": "@pop"
          }
        ]
      ]
    }
  },
