      "__init__",
      "__import__"
    ],
    "brackets": [
      {
        "open": "{",
        "close": "}",
        "token": "delimiter.curly"
      },
      {
        "open": "[",
        "close": "]",
        "token": "delimiter.bracket"
      },
      {
        "open": "(",
        "close": ")",
        "token": "delimiter.parenthesis"
      }
    ],
    "tokenizer": {
      "root": [
        {
          "include": "@whitespace"
        },
        {
          "include": "@numbers"
        },
        {
          "include": "@strings"
        },
        [
          {
            "$regex": "[,:;]",
            "$flags": ""
          },
          "delimiter"
        ],
        [
          {
            "$regex": "[{}\\[\\]()]",
            "$flags": ""
          },
          "@brackets"
        ],
        [
          {
            "$regex": "@[a-zA-Z_]\\w*",
            "$flags": ""
          },
          "tag"
        ],
        [
          {
            "$regex": "[a-zA-Z_]\\w*",
            "$flags": ""
          },
          {
            "cases": {
              "@keywords": "keyword",
              "@default": "identifier"
            }
          }
        ]
      ],
      "whitespace": [
        [
          {
            "$regex": "\\s+",
            "$flags": ""
          },
          "white"
        ],
        [
          {
            "$regex": "(^#.*$)",
            "$flags": ""
          },
          "comment"
        ],
        [
          {
            "$regex": "'''",
            "$flags": ""
          },
          "string",
          "@endDocString"
        ],
        [
          {
            "$regex": "\"\"\"",
            "$flags": ""
          },
          "string",
          "@endDblDocString"
        ]
      ],
      "endDocString": [
        [
          {
            "$regex": "[^']+",
            "$flags": ""
          },
          "string"
        ],
        [
          {
            "$regex": "\\\\'",
            "$flags": ""
          },
          "string"
        ],
        [
          {
            "$regex": "'''",
            "$flags": ""
          },
          "string",
          "@popall"
        ],
        [
          {
            "$regex": "'",
            "$flags": ""
          },
          "string"
        ]
      ],
      "endDblDocString": [
        [
          {
            "$regex": "[^\"]+",
            "$flags": ""
          },
          "string"
        ],
        [
          {
            "$regex": "\\\\\"",
            "$flags": ""
          },
          "string"
        ],
        [
          {
            "$regex": "\"\"\"",
            "$flags": ""
          },
          "string",
          "@popall"
        ],
        [
          {
            "$regex": "\"",
            "$flags": ""
          },
          "string"
        ]
      ],
      "numbers": [
        [
          {
            "$regex": "-?0x([abcdef]|[ABCDEF]|\\d)+[lL]?",
            "$flags": ""
          },
          "number.hex"
        ],
        [
          {
            "$regex": "-?(\\d*\\.)?\\d+([eE][+\\-]?\\d+)?[jJ]?[lL]?",
            "$flags": ""
          },
          "number"
        ]
      ],
      "strings": [
        [
          {
            "$regex": "'$",
            "$flags": ""
          },
          "string.escape",
          "@popall"
        ],
        [
          {
            "$regex": "f'{1,3}",
            "$flags": ""
          },
          "string.escape",
          "@fStringBody"
        ],
        [
          {
            "$regex": "'",
            "$flags": ""
          },
          "string.escape",
          "@stringBody"
        ],
        [
          {
            "$regex": "\"$",
            "$flags": ""
          },
          "string.escape",
          "@popall"
        ],
        [
          {
            "$regex": "f\"{1,3}",
            "$flags": ""
          },
          "string.escape",
          "@fDblStringBody"
        ],
        [
          {
            "$regex": "\"",
            "$flags": ""
          },
          "string.escape",
          "@dblStringBody"
        ]
      ],
      "fStringBody": [
        [
          {
            "$regex": "[^\\\\'\\{\\}]+$",
            "$flags": ""
          },
          "string",
          "@popall"
        ],
        [
          {
            "$regex": "[^\\\\'\\{\\}]+",
            "$flags": ""
          },
          "string"
        ],
        [
          {
            "$regex": "\\{[^\\}':!=]+",
            "$flags": ""
          },
          "identifier",
          "@fStringDetail"
        ],
        [
          {
            "$regex": "\\\\.",
            "$flags": ""
          },
          "string"
        ],
        [
          {
            "$regex": "'",
            "$flags": ""
          },
          "string.escape",
          "@popall"
        ],
        [
          {
            "$regex": "\\\\$",
            "$flags": ""
          },
          "string"
        ]
      ],
      "stringBody": [
        [
          {
            "$regex": "[^\\\\']+$",
            "$flags": ""
          },
          "string",
          "@popall"
        ],
        [
          {
            "$regex": "[^\\\\']+",
            "$flags": ""
          },
          "string"
        ],
        [
          {
            "$regex": "\\\\.",
            "$flags": ""
          },
          "string"
        ],
        [
          {
            "$regex": "'",
            "$flags": ""
          },
          "string.escape",
          "@popall"
        ],
        [
          {
            "$regex": "\\\\$",
            "$flags": ""
          },
          "string"
        ]
      ],
      "fDblStringBody": [
        [
          {
            "$regex": "[^\\\\\"\\{\\}]+$",
            "$flags": ""
          },
          "string",
          "@popall"
        ],
        [
          {
            "$regex": "[^\\\\\"\\{\\}]+",
            "$flags": ""
          },
          "string"
        ],
        [
          {
            "$regex": "\\{[^\\}':!=]+",
            "$flags": ""
          },
          "identifier",
          "@fStringDetail"
        ],
        [
          {
            "$regex": "\\\\.",
            "$flags": ""
          },
          "string"
        ],
        [
          {
            "$regex": "\"",
            "$flags": ""
          },
          "string.escape",
          "@popall"
        ],
        [
          {
            "$regex": "\\\\$",
            "$flags": ""
          },
          "string"
        ]
      ],
      "dblStringBody": [
        [
          {
            "$regex": "[^\\\\\"]+$",
            "$flags": ""
          },
          "string",
          "@popall"
        ],
        [
          {
            "$regex": "[^\\\\\"]+",
            "$flags": ""
          },
          "string"
        ],
        [
          {
            "$regex": "\\\\.",
            "$flags": ""
          },
          "string"
        ],
        [
          {
            "$regex": "\"",
            "$flags": ""
          },
          "string.escape",
          "@popall"
        ],
        [
          {
            "$regex": "\\\\$",
            "$flags": ""
          },
          "string"
        ]
      ],
      "fStringDetail": [
        [
          {
            "$regex": "[:][^}]+",
            "$flags": ""
          },
          "string"
        ],
        [
          {
            "$regex": "[!][ars]",
            "$flags": ""
          },
          "string"
        ],
        [
          {
            "$regex": "=",
            "$flags": ""
          },
          "string"
        ],
        [
          {
            "$regex": "\\}",
            "$flags": ""
          },
          "identifier",
          "@pop"
        ]
      ]
    }
  },
  "configuration": {
    "comments": {
      "lineComment": "#",
      "blockComment": [
        "'''",
        "'''"
      ]
    },
    "brackets": [
      [
        "{",
        "}"
      ],
      [
        "[",
        "]"
      ],
      [
        "(",
        ")"
      ]
    ],
    "autoClosingPairs": [
      {
        "open": "{",
        "close": "}"
      },
      {
        "open": "[",
        "close": "]"
      },
      {
        "open": "(",
        "close": ")"
      },
      {
        "open": "\"",
        "close": "\"",
        "notIn": [
          "string"
        ]
      },
      {
        "open": "'",
        "close": "'",
        "notIn": [
          "string",
          "comment"
        ]
      }
    ],
    "surroundingPairs": [
      {
        "open": "{",
        "close": "}"
      },
      {
        "open": "[",
        "close": "]"
      },
      {
        "open": "(",
        "close": ")"
      },
      {
        "open": "\"",
        "close": "\""
      },
      {
        "open": "'",
        "close": "'"
      }
    ],
    "onEnterRules": [
      {
        "beforeText": {
          "$regex": "^\\s*(?:def|class|for|if|elif|else|while|try|with|finally|except|async|match|case).*?:\\s*$",
          "$flags": ""
        },
        "action": {
          "indentAction": 1
        }
      }
    ],
    "folding": {
      "offSide": true,
      "markers": {
        "start": {
          "$regex": "^\\s*#region\\b",
          "$flags": ""
        },
        "end": {
          "$regex": "^\\s*#endregion\\b",
          "$flags": ""
        }
      }
    }
  }
}
