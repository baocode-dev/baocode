      },
      {
        "open": "'",
        "close": "'"
      },
      {
        "open": "<",
        "close": ">"
      }
    ],
    "folding": {
      "markers": {
        "start": {
          "$regex": "^\\s*\\/\\/\\s*(?:(?:#?region\\b)|(?:<editor-fold\\b))",
          "$flags": ""
        },
        "end": {
          "$regex": "^\\s*\\/\\/\\s*(?:(?:#?endregion\\b)|(?:<\\/editor-fold>))",
          "$flags": ""
        }
      }
    }
  }
