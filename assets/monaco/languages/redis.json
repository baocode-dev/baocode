          "white"
        ]
      ],
      "pseudoColumns": [
        [
          {
            "$regex": "[$][A-Za-z_][\\w@#$]*",
            "$flags": ""
          },
          {
            "cases": {
              "@pseudoColumns": "predefined",
              "@default": "identifier"
            }
          }
        ]
      ],
      "numbers": [
        [
          {
            "$regex": "0[xX][0-9a-fA-F]*",
            "$flags": ""
          },
          "number"
        ],
        [
          {
            "$regex": "[$][+-]*\\d*(\\.\\d*)?",
            "$flags": ""
          },
          "number"
        ],
        [
          {
            "$regex": "((\\d+(\\.\\d*)?)|(\\.\\d+))([eE][\\-+]?\\d+)?",
            "$flags": ""
          },
          "number"
        ]
      ],
      "strings": [
        [
          {
            "$regex": "'",
            "$flags": ""
          },
          {
            "token": "string",
            "next": "@string"
          }
        ],
        [
          {
            "$regex": "\"",
            "$flags": ""
          },
          {
            "token": "string.double",
            "next": "@stringDouble"
          }
        ]
      ],
      "string": [
        [
          {
            "$regex": "[^']+",
            "$flags": ""
          },
          "string"
        ],
        [
          {
            "$regex": "''",
            "$flags": ""
          },
          "string"
        ],
        [
          {
            "$regex": "'",
            "$flags": ""
          },
          {
            "token": "string",
            "next": "@pop"
          }
        ]
      ],
      "stringDouble": [
        [
          {
            "$regex": "[^\"]+",
            "$flags": ""
          },
          "string.double"
        ],
        [
          {
            "$regex": "\"\"",
            "$flags": ""
          },
          "string.double"
        ],
        [
          {
            "$regex": "\"",
            "$flags": ""
          },
          {
            "token": "string.double",
            "next": "@pop"
          }
