    "escapes": {
      "$regex": "\\\\(?:[0abfnrtv\\\\\"']|x[0-9A-Fa-f]{1,4}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})",
      "$flags": ""
    },
    "integersuffix": {
      "$regex": "([uU](ll|LL|l|L)|(ll|LL|l|L)?[uU]?)",
      "$flags": ""
    },
    "floatsuffix": {
      "$regex": "[fFlL]?",
      "$flags": ""
    },
    "encoding": {
      "$regex": "u|u8|U|L",
      "$flags": ""
    },
    "tokenizer": {
      "root": [
        [
          {
            "$regex": "@encoding?R\\\"(?:([^ ()\\\\\\t]*))\\(",
            "$flags": ""
          },
          {
            "token": "string.raw.begin",
            "next": "@raw.$1"
          }
        ],
        [
          {
            "$regex": "[a-zA-Z_]\\w*",
            "$flags": ""
          },
          {
            "cases": {
              "@keywords": {
                "token": "keyword.$0"
              },
              "@default": "identifier"
            }
          }
        ],
        [
          {
            "$regex": "^\\s*#\\s*include",
            "$flags": ""
          },
          {
            "token": "keyword.directive.include",
            "next": "@include"
          }
        ],
        [
          {
            "$regex": "^\\s*#\\s*\\w+",
            "$flags": ""
          },
          "keyword.directive"
        ],
        {
          "include": "@whitespace"
        },
        [
          {
            "$regex": "\\[\\s*\\[",
            "$flags": ""
          },
          {
            "token": "annotation",
            "next": "@annotation"
          }
        ],
        [
          {
            "$regex": "[{}()<>\\[\\]]",
            "$flags": ""
          },
          "@brackets"
        ],
        [
          {
            "$regex": "@symbols",
            "$flags": ""
          },
          {
            "cases": {
              "@operators": "delimiter",
              "@default": ""
            }
          }
        ],
        [
          {
            "$regex": "\\d*\\d+[eE]([\\-+]?\\d+)?(@floatsuffix)",
            "$flags": ""
          },
          "number.float"
        ],
        [
          {
            "$regex": "\\d*\\.\\d+([eE][\\-+]?\\d+)?(@floatsuffix)",
            "$flags": ""
          },
          "number.float"
        ],
        [
          {
            "$regex": "0[xX][0-9a-fA-F']*[0-9a-fA-F](@integersuffix)",
            "$flags": ""
          },
          "number.hex"
        ],
        [
          {
            "$regex": "0[0-7']*[0-7](@integersuffix)",
            "$flags": ""
          },
          "number.octal"
        ],
        [
          {
            "$regex": "0[bB][0-1']*[0-1](@integersuffix)",
            "$flags": ""
          },
          "number.binary"
        ],
        [
          {
            "$regex": "\\d[\\d']*\\d(@integersuffix)",
            "$flags": ""
          },
          "number"
        ],
        [
          {
            "$regex": "\\d(@integersuffix)",
            "$flags": ""
          },
          "number"
        ],
        [
          {
            "$regex": "[;,.]",
            "$flags": ""
          },
          "delimiter"
        ],
        [
          {
            "$regex": "\"([^\"\\\\]|\\\\.)*$",
            "$flags": ""
          },
          "string.invalid"
        ],
        [
          {
            "$regex": "\"",
            "$flags": ""
          },
          "string",
          "@string"
        ],
        [
          {
            "$regex": "'[^\\\\']'",
            "$flags": ""
          },
          "string"
        ],
        [
          {
            "$regex": "(')(@escapes)(')",
            "$flags": ""
          },
          [
            "string",
            "string.escape",
            "string"
          ]
        ],
        [
          {
            "$regex": "'",
            "$flags": ""
          },
          "string.invalid"
        ]
      ],
      "whitespace": [
        [
          {
            "$regex": "[ \\t\\r\\n]+",
            "$flags": ""
          },
          ""
        ],
        [
          {
            "$regex": "\\/\\*\\*(?!\\/)",
            "$flags": ""
          },
          "comment.doc",
          "@doccomment"
        ],
        [
          {
            "$regex": "\\/\\*",
            "$flags": ""
          },
          "comment",
          "@comment"
        ],
        [
          {
            "$regex": "\\/\\/.*\\\\$",
            "$flags": ""
          },
          "comment",
          "@linecomment"
        ],
        [
          {
            "$regex": "\\/\\/.*$",
            "$flags": ""
          },
          "comment"
        ]
      ],
      "comment": [
        [
          {
            "$regex": "[^\\/*]+",
            "$flags": ""
          },
          "comment"
        ],
        [
          {
            "$regex": "\\*\\/",
            "$flags": ""
          },
          "comment",
          "@pop"
        ],
        [
          {
            "$regex": "[\\/*]",
            "$flags": ""
          },
          "comment"
        ]
      ],
      "linecomment": [
        [
          {
            "$regex": ".*[^\\\\]$",
            "$flags": ""
          },
          "comment",
          "@pop"
        ],
        [
          {
            "$regex": "[^]+",
            "$flags": ""
          },
          "comment"
        ]
      ],
      "doccomment": [
        [
          {
            "$regex": "[^\\/*]+",
            "$flags": ""
          },
          "comment.doc"
        ],
        [
          {
            "$regex": "\\*\\/",
            "$flags": ""
          },
          "comment.doc",
          "@pop"
        ],
        [
          {
            "$regex": "[\\/*]",
            "$flags": ""
          },
          "comment.doc"
        ]
      ],
      "string": [
        [
          {
            "$regex": "[^\\\\\"]+",
            "$flags": ""
          },
          "string"
        ],
        [
          {
            "$regex": "@escapes",
            "$flags": ""
          },
          "string.escape"
        ],
        [
          {
            "$regex": "\\\\.",
            "$flags": ""
          },
          "string.escape.invalid"
        ],
        [
          {
            "$regex": "\"",
            "$flags": ""
          },
          "string",
          "@pop"
        ]
      ],
      "raw": [
        [
          {
            "$regex": "[^)]+",
            "$flags": ""
          },
          "string.raw"
        ],
        [
          {
            "$regex": "\\)$S2\\\"",
            "$flags": ""
          },
          {
            "token": "string.raw.end",
            "next": "@pop"
          }
        ],
        [
          {
            "$regex": "\\)",
            "$flags": ""
          },
          "string.raw"
        ]
      ],
      "annotation": [
        {
          "include": "@whitespace"
        },
        [
          {
            "$regex": "using|alignas",
            "$flags": ""
          },
          "keyword"
        ],
        [
          {
            "$regex": "[a-zA-Z0-9_]+",
            "$flags": ""
          },
          "annotation"
        ],
        [
          {
            "$regex": "[,:]",
            "$flags": ""
          },
          "delimiter"
        ],
        [
          {
            "$regex": "[()]",
            "$flags": ""
          },
          "@brackets"
        ],
        [
          {
            "$regex": "\\]\\s*\\]",
            "$flags": ""
          },
          {
            "token": "annotation",
            "next": "@pop"
          }
        ]
      ],
      "include": [
        [
          {
            "$regex": "(\\s*)(<)([^<>]*)(>)",
            "$flags": ""
          },
          [
            "",
            "keyword.directive.include.begin",
            "string.include.identifier",
            {
              "token": "keyword.directive.include.end",
              "next": "@pop"
            }
          ]
        ],
        [
          {
            "$regex": "(\\s*)(\")([^\"]*)(\")",
            "$flags": ""
          },
          [
            "",
            "keyword.directive.include.begin",
            "string.include.identifier",
            {
              "token": "keyword.directive.include.end",
              "next": "@pop"
            }
          ]
        ]
      ]
    }
  },
  "configuration": {
    "comments": {
      "lineComment": "//",
      "blockComment": [
        "/*",
        "*/"
      ]
    },
    "brackets": [
      [
        "{",
        "}"
      ],
      [
        "[",
        "]"
      ],
      [
        "(",
        ")"
      ]
    ],
    "autoClosingPairs": [
      {
        "open": "[",
        "close": "]"
      },
      {
        "open": "{",
        "close": "}"
      },
      {
        "open": "(",
        "close": ")"
      },
      {
        "open": "'",
        "close": "'",
        "notIn": [
          "string",
          "comment"
        ]
      },
      {
        "open": "\"",
        "close": "\"",
        "notIn": [
          "string"
        ]
      }
    ],
    "surroundingPairs": [
      {
        "open": "{",
        "close": "}"
      },
      {
        "open": "[",
        "close": "]"
      },
      {
        "open": "(",
        "close": ")"
      },
      {
        "open": "\"",
        "close": "\""
      },
      {
        "open": "'",
        "close": "'"
      }
    ],
    "folding": {
      "markers": {
        "start": {
          "$regex": "^\\s*#pragma\\s+region\\b",
          "$flags": ""
        },
        "end": {
          "$regex": "^\\s*#pragma\\s+endregion\\b",
          "$flags": ""
        }
      }
    }
