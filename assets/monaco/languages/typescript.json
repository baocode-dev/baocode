  "languageId": "typescript",
  "language": {
    "defaultToken": "invalid",
    "tokenPostfix": ".ts",
    "keywords": [
      "abstract",
      "any",
      "as",
      "asserts",
      "bigint",
      "boolean",
      "break",
      "case",
      "catch",
      "class",
      "continue",
