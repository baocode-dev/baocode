      "<<=",
      ">>=",
      ">>",
      "=>"
    ],
    "symbols": {
      "$regex": "[=><!~?:&|+\\-*\\/\\^%]+",
      "$flags": ""
    },
    "escapes": {
      "$regex": "\\\\(?:[abfnrtv\\\\\"']|x[0-9A-Fa-f]{1,4}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})",
      "$flags": ""
    },
    "tokenizer": {
      "root": [
        [
          {
            "$regex": "\\@?[a-zA-Z_]\\w*",
            "$flags": ""
          },
          {
            "cases": {
              "@namespaceFollows": {
                "token": "keyword.$0",
                "next": "@namespace"
              },
              "@keywords": {
                "token": "keyword.$0",
                "next": "@qualified"
              },
              "@default": {
                "token": "identifier",
                "next": "@qualified"
              }
            }
          }
        ],
        {
          "include": "@whitespace"
        },
        [
          {
            "$regex": "}",
            "$flags": ""
          },
          {
            "cases": {
              "$S2==interpolatedstring": {
                "token": "string.quote",
                "next": "@pop"
              },
              "$S2==litinterpstring": {
                "token": "string.quote",
                "next": "@pop"
              },
              "@default": "@brackets"
            }
          }
        ],
        [
          {
            "$regex": "[{}()\\[\\]]",
            "$flags": ""
          },
          "@brackets"
        ],
        [
          {
            "$regex": "[<>](?!@symbols)",
            "$flags": ""
          },
          "@brackets"
        ],
        [
          {
            "$regex": "@symbols",
            "$flags": ""
          },
          {
            "cases": {
              "@operators": "delimiter",
              "@default": ""
            }
          }
        ],
        [
          {
            "$regex": "[0-9_]*\\.[0-9_]+([eE][\\-+]?\\d+)?[fFdD]?",
            "$flags": ""
          },
          "number.float"
        ],
        [
          {
            "$regex": "0[xX][0-9a-fA-F_]+",
            "$flags": ""
          },
          "number.hex"
        ],
        [
          {
            "$regex": "0[bB][01_]+",
            "$flags": ""
          },
          "number.hex"
        ],
        [
          {
            "$regex": "[0-9_]+",
            "$flags": ""
          },
          "number"
        ],
        [
          {
            "$regex": "[;,.]",
            "$flags": ""
          },
          "delimiter"
        ],
        [
          {
            "$regex": "\"([^\"\\\\]|\\\\.)*$",
            "$flags": ""
          },
          "string.invalid"
        ],
        [
          {
            "$regex": "\"",
            "$flags": ""
          },
          {
            "token": "string.quote",
            "next": "@string"
          }
        ],
        [
          {
            "$regex": "\\$\\@\"",
            "$flags": ""
          },
          {
            "token": "string.quote",
            "next": "@litinterpstring"
          }
        ],
        [
          {
            "$regex": "\\@\"",
            "$flags": ""
          },
          {
            "token": "string.quote",
            "next": "@litstring"
          }
        ],
        [
          {
            "$regex": "\\$\"",
            "$flags": ""
          },
          {
            "token": "string.quote",
            "next": "@interpolatedstring"
          }
        ],
        [
          {
            "$regex": "'[^\\\\']'",
            "$flags": ""
          },
          "string"
        ],
        [
          {
            "$regex": "(')(@escapes)(')",
            "$flags": ""
          },
          [
            "string",
            "string.escape",
            "string"
          ]
        ],
        [
          {
            "$regex": "'",
            "$flags": ""
          },
          "string.invalid"
        ]
      ],
      "qualified": [
        [
          {
            "$regex": "[a-zA-Z_][\\w]*",
            "$flags": ""
          },
          {
            "cases": {
              "@keywords": {
                "token": "keyword.$0"
              },
              "@default": "identifier"
            }
          }
        ],
        [
          {
            "$regex": "\\.",
            "$flags": ""
          },
          "delimiter"
        ],
        [
          "",
          "",
          "@pop"
        ]
      ],
      "namespace": [
        {
          "include": "@whitespace"
        },
        [
          {
            "$regex": "[A-Z]\\w*",
            "$flags": ""
          },
          "namespace"
        ],
        [
          {
            "$regex": "[\\.=]",
            "$flags": ""
          },
          "delimiter"
        ],
        [
          "",
          "",
          "@pop"
        ]
      ],
      "comment": [
        [
          {
            "$regex": "[^\\/*]+",
            "$flags": ""
          },
          "comment"
        ],
        [
          "\\*/",
          "comment",
          "@pop"
        ],
        [
          {
            "$regex": "[\\/*]",
            "$flags": ""
          },
          "comment"
        ]
      ],
      "string": [
        [
          {
            "$regex": "[^\\\\\"]+",
            "$flags": ""
          },
          "string"
        ],
        [
          {
            "$regex": "@escapes",
            "$flags": ""
          },
          "string.escape"
        ],
        [
          {
            "$regex": "\\\\.",
            "$flags": ""
          },
          "string.escape.invalid"
        ],
        [
          {
            "$regex": "\"",
            "$flags": ""
          },
          {
            "token": "string.quote",
            "next": "@pop"
          }
        ]
      ],
      "litstring": [
        [
          {
            "$regex": "[^\"]+",
            "$flags": ""
          },
          "string"
        ],
        [
          {
            "$regex": "\"\"",
            "$flags": ""
          },
          "string.escape"
        ],
        [
          {
            "$regex": "\"",
            "$flags": ""
          },
          {
            "token": "string.quote",
            "next": "@pop"
          }
        ]
      ],
      "litinterpstring": [
        [
          {
            "$regex": "[^\"{]+",
            "$flags": ""
          },
          "string"
        ],
        [
          {
            "$regex": "\"\"",
            "$flags": ""
          },
          "string.escape"
        ],
        [
          {
            "$regex": "{{",
            "$flags": ""
          },
          "string.escape"
        ],
        [
          {
            "$regex": "}}",
            "$flags": ""
          },
          "string.escape"
        ],
        [
          {
            "$regex": "{",
            "$flags": ""
          },
          {
            "token": "string.quote",
            "next": "root.litinterpstring"
          }
        ],
        [
          {
            "$regex": "\"",
            "$flags": ""
          },
          {
            "token": "string.quote",
            "next": "@pop"
          }
        ]
      ],
      "interpolatedstring": [
        [
          {
            "$regex": "[^\\\\\"{]+",
            "$flags": ""
          },
          "string"
        ],
        [
          {
            "$regex": "@escapes",
            "$flags": ""
          },
          "string.escape"
        ],
        [
          {
            "$regex": "\\\\.",
            "$flags": ""
          },
          "string.escape.invalid"
        ],
        [
          {
            "$regex": "{{",
            "$flags": ""
          },
          "string.escape"
        ],
        [
          {
            "$regex": "}}",
            "$flags": ""
          },
          "string.escape"
        ],
        [
          {
            "$regex": "{",
            "$flags": ""
          },
          {
            "token": "string.quote",
            "next": "root.interpolatedstring"
          }
        ],
        [
          {
            "$regex": "\"",
            "$flags": ""
          },
          {
            "token": "string.quote",
            "next": "@pop"
          }
        ]
      ],
      "whitespace": [
        [
          {
            "$regex": "^[ \\t\\v\\f]*#((r)|(load))(?=\\s)",
            "$flags": ""
          },
          "directive.csx"
        ],
        [
          {
            "$regex": "^[ \\t\\v\\f]*#\\w.*$",
            "$flags": ""
          },
          "namespace.cpp"
        ],
        [
          {
            "$regex": "[ \\t\\v\\f\\r\\n]+",
            "$flags": ""
          },
          ""
        ],
        [
          {
            "$regex": "\\/\\*",
            "$flags": ""
          },
          "comment",
          "@comment"
        ],
        [
          {
            "$regex": "\\/\\/.*$",
            "$flags": ""
          },
          "comment"
        ]
      ]
    }
  },
  "configuration": {
    "wordPattern": {
      "$regex": "(-?\\d*\\.\\d\\w*)|([^\\`\\~\\!\\#\\$\\%\\^\\&\\*\\(\\)\\-\\=\\+\\[\\{\\]\\}\\\\\\|\\;\\:\\'\\\"\\,\\.\\<\\>\\/\\?\\s]+)",
      "$flags": "g"
    },
    "comments": {
      "lineComment": "//",
      "blockComment": [
        "/*",
        "*/"
      ]
    },
    "brackets": [
      [
        "{",
        "}"
      ],
      [
        "[",
        "]"
      ],
      [
        "(",
        ")"
      ]
    ],
    "autoClosingPairs": [
