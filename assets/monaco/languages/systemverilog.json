    "tokenizer": {
      "root": [
        [
          {
            "$regex": "^(\\s*)(@identifier)",
            "$flags": ""
          },
          [
            "",
            {
              "cases": {
                "@builtin_gates": {
                  "token": "keyword.$2",
                  "next": "@module_instance"
                },
                "table": {
                  "token": "keyword.$2",
                  "next": "@table"
                },
                "@keywords": {
                  "token": "keyword.$2"
                },
                "@default": {
                  "token": "identifier",
                  "next": "@module_instance"
                }
              }
            }
          ]
        ],
        [
          {
            "$regex": "^\\s*`include",
            "$flags": ""
          },
          {
            "token": "keyword.directive.include",
            "next": "@include"
          }
        ],
        [
          {
            "$regex": "^\\s*`\\s*\\w+",
            "$flags": ""
          },
          "keyword"
        ],
        {
          "include": "@identifier_or_keyword"
        },
        {
          "include": "@whitespace"
        },
        [
          {
            "$regex": "\\(\\*.*\\*\\)",
            "$flags": ""
          },
          "annotation"
        ],
        [
          {
            "$regex": "@systemcall",
            "$flags": ""
          },
          "variable.predefined"
        ],
        [
          {
            "$regex": "[{}()\\[\\]]",
            "$flags": ""
          },
          "@brackets"
        ],
        [
          {
            "$regex": "[<>](?!@symbols)",
            "$flags": ""
          },
          "@brackets"
        ],
        [
          {
            "$regex": "@symbols",
            "$flags": ""
          },
          {
            "cases": {
              "@operators": "delimiter",
              "@default": ""
            }
          }
        ],
        {
          "include": "@numbers"
        },
        [
          {
            "$regex": "[;,.]",
            "$flags": ""
          },
          "delimiter"
        ],
        {
          "include": "@strings"
        }
      ],
      "identifier_or_keyword": [
        [
          {
            "$regex": "@identifier",
            "$flags": ""
          },
          {
            "cases": {
              "@keywords": {
                "token": "keyword.$0"
              },
              "@default": "identifier"
            }
          }
        ]
      ],
      "numbers": [
        [
          {
            "$regex": "\\d+?[\\d_]*(?:\\.[\\d_]+)?[eE][\\-+]?\\d+",
            "$flags": ""
          },
          "number.float"
        ],
        [
          {
            "$regex": "\\d+?[\\d_]*\\.[\\d_]+(?:\\s*@timeunits)?",
            "$flags": ""
          },
          "number.float"
        ],
        [
          {
            "$regex": "(?:\\d+?[\\d_]*\\s*)?'[sS]?[dD]\\s*[0-9xXzZ?]+?[0-9xXzZ?_]*",
            "$flags": ""
          },
          "number"
        ],
        [
          {
            "$regex": "(?:\\d+?[\\d_]*\\s*)?'[sS]?[bB]\\s*[0-1xXzZ?]+?[0-1xXzZ?_]*",
            "$flags": ""
          },
          "number.binary"
        ],
        [
          {
            "$regex": "(?:\\d+?[\\d_]*\\s*)?'[sS]?[oO]\\s*[0-7xXzZ?]+?[0-7xXzZ?_]*",
            "$flags": ""
          },
          "number.octal"
        ],
        [
          {
            "$regex": "(?:\\d+?[\\d_]*\\s*)?'[sS]?[hH]\\s*[0-9a-fA-FxXzZ?]+?[0-9a-fA-FxXzZ?_]*",
            "$flags": ""
          },
          "number.hex"
        ],
        [
          {
            "$regex": "1step",
            "$flags": ""
          },
          "number"
        ],
        [
          {
            "$regex": "[\\dxXzZ]+?[\\dxXzZ_]*(?:\\s*@timeunits)?",
            "$flags": ""
          },
          "number"
        ],
        [
          {
            "$regex": "'[01xXzZ]+",
            "$flags": ""
          },
          "number"
        ]
      ],
      "module_instance": [
        {
          "include": "@whitespace"
        },
        [
          {
            "$regex": "(#?)(\\()",
            "$flags": ""
          },
          [
            "",
            {
              "token": "@brackets",
              "next": "@port_connection"
            }
          ]
        ],
        [
          {
            "$regex": "@identifier\\s*[;={}\\[\\],]",
            "$flags": ""
          },
          {
            "token": "@rematch",
            "next": "@pop"
          }
        ],
        [
          {
            "$regex": "@symbols|[;={}\\[\\],]",
            "$flags": ""
          },
          {
            "token": "@rematch",
            "next": "@pop"
          }
        ],
        [
          {
            "$regex": "@identifier",
            "$flags": ""
          },
          "type"
        ],
        [
          {
            "$regex": ";",
            "$flags": ""
          },
          "delimiter",
          "@pop"
        ]
      ],
      "port_connection": [
        {
          "include": "@identifier_or_keyword"
        },
        {
          "include": "@whitespace"
        },
        [
          {
            "$regex": "@systemcall",
            "$flags": ""
          },
          "variable.predefined"
        ],
        {
          "include": "@numbers"
        },
        {
          "include": "@strings"
        },
        [
          {
            "$regex": "[,]",
            "$flags": ""
          },
          "delimiter"
        ],
        [
          {
            "$regex": "\\(",
            "$flags": ""
          },
          "@brackets",
          "@port_connection"
        ],
        [
          {
            "$regex": "\\)",
            "$flags": ""
          },
          "@brackets",
          "@pop"
        ]
      ],
      "whitespace": [
        [
          {
            "$regex": "[ \\t\\r\\n]+",
            "$flags": ""
          },
          ""
        ],
        [
          {
            "$regex": "\\/\\*",
            "$flags": ""
          },
          "comment",
          "@comment"
        ],
        [
          {
            "$regex": "\\/\\/.*$",
            "$flags": ""
          },
          "comment"
        ]
      ],
      "comment": [
        [
          {
            "$regex": "[^\\/*]+",
            "$flags": ""
          },
          "comment"
        ],
        [
          {
            "$regex": "\\*\\/",
            "$flags": ""
          },
          "comment",
          "@pop"
        ],
        [
          {
            "$regex": "[\\/*]",
            "$flags": ""
          },
          "comment"
        ]
      ],
      "strings": [
        [
          {
            "$regex": "\"([^\"\\\\]|\\\\.)*$",
            "$flags": ""
          },
          "string.invalid"
        ],
        [
          {
            "$regex": "\"",
            "$flags": ""
          },
          "string",
          "@string"
        ]
      ],
      "string": [
        [
          {
            "$regex": "[^\\\\\"]+",
            "$flags": ""
          },
          "string"
        ],
        [
          {
            "$regex": "@escapes",
            "$flags": ""
          },
          "string.escape"
        ],
        [
          {
            "$regex": "\\\\.",
            "$flags": ""
          },
          "string.escape.invalid"
        ],
        [
          {
            "$regex": "\"",
            "$flags": ""
          },
          "string",
          "@pop"
        ]
      ],
      "include": [
        [
          {
            "$regex": "(\\s*)(\")([\\w*\\/*]*)(.\\w*)(\")",
            "$flags": ""
          },
          [
            "",
            "string.include.identifier",
            "string.include.identifier",
            "string.include.identifier",
            {
              "token": "string.include.identifier",
              "next": "@pop"
            }
          ]
        ],
        [
          {
            "$regex": "(\\s*)(<)([\\w*\\/*]*)(.\\w*)(>)",
            "$flags": ""
          },
          [
            "",
            "string.include.identifier",
            "string.include.identifier",
            "string.include.identifier",
            {
              "token": "string.include.identifier",
              "next": "@pop"
            }
          ]
        ]
      ],
      "table": [
        {
          "include": "@whitespace"
        },
        [
          {
            "$regex": "[()]",
            "$flags": ""
          },
          "@brackets"
        ],
        [
          {
            "$regex": "[:;]",
            "$flags": ""
          },
          "delimiter"
        ],
        [
          {
            "$regex": "[01\\-*?xXbBrRfFpPnN]",
            "$flags": ""
          },
          "variable.predefined"
        ],
        [
          "endtable",
          "keyword.endtable",
          "@pop"
        ]
      ]
    }
  },
