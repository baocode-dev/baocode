        "close": "'"
      }
    ],
    "folding": {
      "offSide": false,
      "markers": {
        "start": {
          "$regex": "^(?:\\s*|.*(?!\\/[\\/\\*])[^\\w])(?:begin|case(x|z)?|class|clocking|config|covergroup|function|generate|interface|module|package|primitive|property|program|sequence|specify|table|task)\\b",
          "$flags": ""
        },
        "end": {
          "$regex": "^(?:\\s*|.*(?!\\/[\\/\\*])[^\\w])(?:end|endcase|endclass|endclocking|endconfig|endgroup|endfunction|endgenerate|endinterface|endmodule|endpackage|endprimitive|endproperty|endprogram|endsequence|endspecify|endtable|endtask)\\b",
          "$flags": ""
        }
      }
