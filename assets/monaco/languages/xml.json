  "languageId": "xml",
  "language": {
    "defaultToken": "",
    "tokenPostfix": ".xml",
    "ignoreCase": true,
    "qualifiedName": {
      "$regex": "(?:[\\w\\.\\-]+:)?[\\w\\.\\-]+",
      "$flags": ""
    },
    "tokenizer": {
      "root": [
        [
          {
            "$regex": "[^<&]+",
            "$flags": ""
          },
          ""
        ],
        {
          "include": "@whitespace"
        },
        [
          {
            "$regex": "(<)(@qualifiedName)",
            "$flags": ""
          },
          [
            {
              "token": "delimiter"
            },
            {
              "token": "tag",
              "next": "@tag"
            }
          ]
        ],
        [
          {
            "$regex": "(<\\/)(@qualifiedName)(\\s*)(>)",
            "$flags": ""
          },
          [
            {
              "token": "delimiter"
            },
            {
              "token": "tag"
            },
            "",
            {
              "token": "delimiter"
            }
          ]
        ],
        [
          {
            "$regex": "(<\\?)(@qualifiedName)",
            "$flags": ""
          },
          [
            {
              "token": "delimiter"
            },
            {
              "token": "metatag",
              "next": "@tag"
            }
          ]
        ],
        [
          {
            "$regex": "(<\\!)(@qualifiedName)",
            "$flags": ""
          },
          [
            {
              "token": "delimiter"
            },
            {
              "token": "metatag",
              "next": "@tag"
            }
          ]
        ],
        [
          {
            "$regex": "<\\!\\[CDATA\\[",
            "$flags": ""
          },
          {
            "token": "delimiter.cdata",
            "next": "@cdata"
          }
        ],
        [
          {
            "$regex": "&\\w+;",
            "$flags": ""
          },
          "string.escape"
        ]
      ],
      "cdata": [
        [
          {
            "$regex": "[^\\]]+",
            "$flags": ""
          },
          ""
        ],
        [
          {
            "$regex": "\\]\\]>",
            "$flags": ""
          },
          {
            "token": "delimiter.cdata",
            "next": "@pop"
          }
        ],
        [
          {
            "$regex": "\\]",
            "$flags": ""
          },
          ""
        ]
      ],
      "tag": [
        [
          {
            "$regex": "[ \\t\\r\\n]+",
            "$flags": ""
          },
          ""
        ],
        [
          {
            "$regex": "(@qualifiedName)(\\s*=\\s*)(\"[^\"]*\"|'[^']*')",
            "$flags": ""
          },
          [
            "attribute.name",
            "",
            "attribute.value"
          ]
        ],
        [
          {
            "$regex": "(@qualifiedName)(\\s*=\\s*)(\"[^\">?\\/]*|'[^'>?\\/]*)(?=[\\?\\/]\\>)",
            "$flags": ""
          },
          [
            "attribute.name",
            "",
            "attribute.value"
          ]
        ],
        [
          {
            "$regex": "(@qualifiedName)(\\s*=\\s*)(\"[^\">]*|'[^'>]*)",
            "$flags": ""
          },
          [
            "attribute.name",
            "",
            "attribute.value"
          ]
        ],
        [
          {
            "$regex": "@qualifiedName",
            "$flags": ""
          },
          "attribute.name"
        ],
        [
          {
            "$regex": "\\?>",
            "$flags": ""
          },
          {
            "token": "delimiter",
            "next": "@pop"
          }
        ],
        [
          {
            "$regex": "(\\/)(>)",
            "$flags": ""
          },
          [
            {
              "token": "tag"
            },
            {
              "token": "delimiter",
              "next": "@pop"
            }
          ]
        ],
        [
          {
            "$regex": ">",
            "$flags": ""
          },
          {
            "token": "delimiter",
            "next": "@pop"
          }
        ]
      ],
      "whitespace": [
        [
          {
            "$regex": "[ \\t\\r\\n]+",
            "$flags": ""
          },
          ""
        ],
        [
          {
            "$regex": "<!--",
            "$flags": ""
          },
          {
            "token": "comment",
            "next": "@comment"
          }
        ]
      ],
      "comment": [
        [
          {
            "$regex": "[^<\\-]+",
            "$flags": ""
          },
          "comment.content"
        ],
        [
          {
            "$regex": "-->",
            "$flags": ""
          },
          {
            "token": "comment",
            "next": "@pop"
          }
        ],
        [
          {
            "$regex": "<!--",
            "$flags": ""
          },
          "comment.content.invalid"
        ],
        [
          {
            "$regex": "[<\\-]",
            "$flags": ""
          },
          "comment.content"
        ]
      ]
    }
  },
  "configuration": {
    "comments": {
      "blockComment": [
        "<!--",
        "-->"
      ]
    },
    "brackets": [
      [
        "<",
        ">"
      ]
    ],
    "autoClosingPairs": [
      {
        "open": "<",
        "close": ">"
      },
      {
        "open": "'",
        "close": "'"
      },
      {
        "open": "\"",
        "close": "\""
      }
    ],
    "surroundingPairs": [
      {
        "open": "<",
        "close": ">"
      },
      {
        "open": "'",
        "close": "'"
      },
      {
        "open": "\"",
        "close": "\""
      }
    ],
    "onEnterRules": [
      {
        "beforeText": {
          "$regex": "<([_:\\w][_:\\w-.\\d]*)([^/>]*(?!\\/)>)[^<]*$",
          "$flags": "i"
        },
        "afterText": {
          "$regex": "^<\\/([_:\\w][_:\\w-.\\d]*)\\s*>$",
          "$flags": "i"
        },
        "action": {
          "indentAction": 2
        }
      },
      {
        "beforeText": {
          "$regex": "<(\\w[\\w\\d]*)([^/>]*(?!\\/)>)[^<]*$",
          "$flags": "i"
        },
        "action": {
          "indentAction": 1
        }
      }
    ]
  }
