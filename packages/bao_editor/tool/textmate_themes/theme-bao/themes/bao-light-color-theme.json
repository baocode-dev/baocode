	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment",
				"string.comment"
			],
			"settings": {
				"foreground": "#85847F"
			}
		},
		{
			"scope": [
				"constant.other.placeholder",
				"constant.character"
			],
			"settings": {
				"foreground": "#9A6421"
			}
		},
		{
			"scope": [
				"constant",
				"entity.name.constant",
				"variable.other.constant",
				"variable.other.enummember",
				"variable.language",
				"entity"
			],
			"settings": {
				"foreground": "#3E6A96"
			}
		},
		{
			"scope": [
				"entity.name",
				"meta.export.default",
				"meta.definition.variable"
			],
			"settings": {
				"foreground": "#2F7A6C"
			}
		},
		{
			"scope": [
				"variable.parameter.function",
				"meta.jsx.children",
				"meta.block",
				"meta.tag.attributes",
				"entity.name.constant",
				"meta.object.member",
				"meta.embedded.expression"
			],
			"settings": {
				"foreground": "#292927"
			}
		},
		{
			"scope": "entity.name.function",
			"settings": {
				"foreground": "#7A55A8"
			}
		},
		{
			"scope": [
				"entity.name.tag",
				"support.class.component"
			],
			"settings": {
				"foreground": "#3D7A47"
			}
		},
		{
			"scope": "keyword",
			"settings": {
				"foreground": "#9A6421"
			}
		},
		{
			"scope": [
				"storage",
				"storage.type"
			],
			"settings": {
				"foreground": "#9A6421"
			}
		},
		{
			"scope": [
				"storage.modifier.package",
				"storage.modifier.import",
				"storage.type.java"
			],
			"settings": {
				"foreground": "#292927"
			}
		},
		{
			"scope": [
				"string",
				"string punctuation.section.embedded source"
			],
			"settings": {
				"foreground": "#5E7A26"
			}
		},
		{
			"scope": "support",
			"settings": {
				"foreground": "#3E6A96"
			}
		},
		{
			"scope": "meta.property-name",
			"settings": {
				"foreground": "#3E6A96"
			}
		},
		{
			"scope": "variable",
			"settings": {
				"foreground": "#2F7A6C"
			}
		},
		{
			"scope": "variable.other",
			"settings": {
				"foreground": "#292927"
			}
		},
		{
			"scope": "invalid.broken",
			"settings": {
				"fontStyle": "italic",
				"foreground": "#B0443A"
			}
		},
		{
			"scope": "invalid.deprecated",
			"settings": {
				"fontStyle": "italic",
				"foreground": "#B0443A"
			}
		},
		{
			"scope": "invalid.illegal",
			"settings": {
				"fontStyle": "italic",
				"foreground": "#B0443A"
			}
		},
		{
			"scope": "invalid.unimplemented",
			"settings": {
				"fontStyle": "italic",
				"foreground": "#B0443A"
			}
		},
		{
			"scope": "carriage-return",
			"settings": {
				"fontStyle": "italic underline",
				"foreground": "#F0EFED"
			}
		},
		{
			"scope": "message.error",
			"settings": {
				"foreground": "#B0443A"
			}
		},
		{
			"scope": "string variable",
			"settings": {
				"foreground": "#3E6A96"
			}
		},
		{
			"scope": [
				"source.regexp",
				"string.regexp"
