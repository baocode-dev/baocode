{
  "revision": "d61824269f1377111d34306e4a47172327777083",
  "attribution": "Copyright (c) Microsoft Corporation. Licensed under the MIT License; see assets/monaco/LICENSE.txt.",
  "languageId": "pascaligo",
  "language": {
    "defaultToken": "",
    "tokenPostfix": ".pascaligo",
    "ignoreCase": true,
    "brackets": [
      {
        "open": "{",
        "close": "}",
        "token": "delimiter.curly"
      },
      {
        "open": "[",
        "close": "]",
        "token": "delimiter.square"
      },
      {
        "open": "(",
        "close": ")",
        "token": "delimiter.parenthesis"
      },
      {
        "open": "<",
        "close": ">",
        "token": "delimiter.angle"
      }
    ],
    "keywords": [
      "begin",
      "block",
      "case",
      "const",
      "else",
      "end",
      "fail",
      "for",
      "from",
      "function",
      "if",
      "is",
      "nil",
      "of",
      "remove",
      "return",
      "skip",
      "then",
      "type",
      "var",
      "while",
      "with",
      "option",
      "None",
      "transaction"
    ],
    "typeKeywords": [
      "bool",
      "int",
      "list",
      "map",
      "nat",
      "record",
      "string",
      "unit",
      "address",
      "map",
      "mtz",
      "xtz"
    ],
    "operators": [
      "=",
      ">",
      "<",
      "<=",
      ">=",
      "<>",
      ":",
      ":=",
      "and",
      "mod",
      "or",
      "+",
      "-",
      "*",
      "/",
      "@",
      "&",
      "^",
      "%"
    ],
    "symbols": {
      "$regex": "[=><:@\\^&|+\\-*\\/\\^%]+",
      "$flags": ""
    },
    "tokenizer": {
      "root": [
        [
          {
            "$regex": "[a-zA-Z_][\\w]*",
            "$flags": ""
          },
          {
            "cases": {
              "@keywords": {
                "token": "keyword.$0"
              },
              "@default": "identifier"
            }
          }
        ],
        {
          "include": "@whitespace"
        },
        [
          {
            "$regex": "[{}()\\[\\]]",
            "$flags": ""
          },
          "@brackets"
        ],
        [
          {
            "$regex": "[<>](?!@symbols)",
            "$flags": ""
          },
          "@brackets"
        ],
        [
          {
            "$regex": "@symbols",
            "$flags": ""
          },
          {
            "cases": {
              "@operators": "delimiter",
              "@default": ""
            }
          }
        ],
        [
          {
            "$regex": "\\d*\\.\\d+([eE][\\-+]?\\d+)?",
            "$flags": ""
          },
          "number.float"
        ],
        [
          {
            "$regex": "\\$[0-9a-fA-F]{1,16}",
            "$flags": ""
          },
          "number.hex"
        ],
        [
          {
            "$regex": "\\d+",
            "$flags": ""
          },
          "number"
        ],
        [
          {
            "$regex": "[;,.]",
            "$flags": ""
          },
          "delimiter"
        ],
        [
          {
            "$regex": "'([^'\\\\]|\\\\.)*$",
            "$flags": ""
          },
          "string.invalid"
        ],
        [
          {
            "$regex": "'",
            "$flags": ""
          },
          "string",
          "@string"
        ],
        [
          {
            "$regex": "'[^\\\\']'",
            "$flags": ""
          },
          "string"
        ],
        [
          {
            "$regex": "'",
            "$flags": ""
          },
          "string.invalid"
        ],
        [
          {
            "$regex": "\\#\\d+",
            "$flags": ""
          },
          "string"
        ]
      ],
      "comment": [
        [
          {
            "$regex": "[^\\(\\*]+",
            "$flags": ""
          },
          "comment"
        ],
        [
          {
            "$regex": "\\*\\)",
            "$flags": ""
          },
          "comment",
          "@pop"
        ],
        [
          {
            "$regex": "\\(\\*",
            "$flags": ""
          },
          "comment"
        ]
      ],
      "string": [
        [
          {
            "$regex": "[^\\\\']+",
            "$flags": ""
          },
          "string"
        ],
        [
          {
            "$regex": "\\\\.",
            "$flags": ""
          },
          "string.escape.invalid"
        ],
        [
          {
            "$regex": "'",
            "$flags": ""
          },
          {
            "token": "string.quote",
            "bracket": "@close",
            "next": "@pop"
          }
        ]
      ],
      "whitespace": [
        [
          {
            "$regex": "[ \\t\\r\\n]+",
            "$flags": ""
          },
          "white"
        ],
        [
          {
            "$regex": "\\(\\*",
            "$flags": ""
          },
          "comment",
          "@comment"
        ],
        [
          {
            "$regex": "\\/\\/.*$",
            "$flags": ""
          },
          "comment"
        ]
      ]
    }
  },
  "configuration": {
    "comments": {
      "lineComment": "//",
      "blockComment": [
        "(*",
        "*)"
      ]
    },
    "brackets": [
      [
        "{",
        "}"
      ],
      [
        "[",
        "]"
      ],
      [
        "(",
        ")"
      ],
      [
        "<",
        ">"
      ]
    ],
    "autoClosingPairs": [
      {
        "open": "{",
        "close": "}"
      },
      {
        "open": "[",
        "close": "]"
      },
      {
        "open": "(",
        "close": ")"
      },
      {
        "open": "<",
        "close": ">"
      },
      {
        "open": "'",
        "close": "'"
      }
    ],
    "surroundingPairs": [
      {
        "open": "{",
        "close": "}"
      },
      {
        "open": "[",
        "close": "]"
      },
      {
        "open": "(",
        "close": ")"
      },
      {
        "open": "<",
        "close": ">"
      },
      {
        "open": "'",
        "close": "'"
      }
    ]
  }
}
