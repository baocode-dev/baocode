    "tokenizer": {
      "root": [
        [
          {
            "$regex": "[a-z_$][\\w$]*",
            "$flags": ""
          },
          {
            "cases": {
              "@keywords": {
                "token": "keyword.$0"
              },
              "@default": "identifier"
            }
          }
        ],
        [
          {
            "$regex": "[A-Z][\\w\\$]*",
            "$flags": ""
          },
          {
            "cases": {
              "@keywords": {
                "token": "keyword.$0"
              },
              "@default": "type.identifier"
            }
          }
        ],
        {
          "include": "@whitespace"
        },
        [
          {
            "$regex": "[{}()\\[\\]]",
            "$flags": ""
          },
          "@brackets"
        ],
        [
          {
            "$regex": "[<>](?!@symbols)",
            "$flags": ""
          },
          "@brackets"
        ],
        [
          {
            "$regex": "@symbols",
            "$flags": ""
          },
          {
            "cases": {
              "@operators": "delimiter",
              "@default": ""
            }
          }
        ],
        [
          {
            "$regex": "@\\s*[a-zA-Z_\\$][\\w\\$]*",
            "$flags": ""
          },
          "annotation"
        ],
        [
          {
            "$regex": "(@digits)[eE]([\\-+]?(@digits))?[fFdD]?",
            "$flags": ""
          },
          "number.float"
        ],
        [
          {
            "$regex": "(@digits)\\.(@digits)([eE][\\-+]?(@digits))?[fFdD]?",
            "$flags": ""
          },
          "number.float"
        ],
        [
          {
            "$regex": "(@digits)[fFdD]",
            "$flags": ""
          },
          "number.float"
        ],
        [
          {
            "$regex": "(@digits)[lL]?",
            "$flags": ""
          },
          "number"
        ],
        [
          {
            "$regex": "[;,.]",
            "$flags": ""
          },
          "delimiter"
        ],
        [
          {
            "$regex": "\"([^\"\\\\]|\\\\.)*$",
            "$flags": ""
          },
          "string.invalid"
        ],
        [
          {
            "$regex": "'([^'\\\\]|\\\\.)*$",
            "$flags": ""
          },
          "string.invalid"
        ],
        [
          {
            "$regex": "\"",
            "$flags": ""
          },
          "string",
          "@string.\""
        ],
        [
          {
            "$regex": "'",
            "$flags": ""
          },
          "string",
          "@string.'"
        ],
        [
          {
            "$regex": "'[^\\\\']'",
            "$flags": ""
          },
          "string"
        ],
        [
          {
            "$regex": "(')(@escapes)(')",
            "$flags": ""
          },
          [
            "string",
            "string.escape",
            "string"
          ]
        ],
        [
          {
            "$regex": "'",
            "$flags": ""
          },
          "string.invalid"
        ]
      ],
      "whitespace": [
        [
          {
            "$regex": "[ \\t\\r\\n]+",
            "$flags": ""
          },
          ""
        ],
        [
          {
            "$regex": "\\/\\*\\*(?!\\/)",
            "$flags": ""
          },
          "comment.doc",
          "@apexdoc"
        ],
        [
          {
            "$regex": "\\/\\*",
            "$flags": ""
          },
          "comment",
          "@comment"
        ],
        [
          {
            "$regex": "\\/\\/.*$",
            "$flags": ""
          },
          "comment"
        ]
      ],
      "comment": [
        [
          {
            "$regex": "[^\\/*]+",
            "$flags": ""
          },
          "comment"
        ],
        [
          {
            "$regex": "\\*\\/",
            "$flags": ""
          },
          "comment",
          "@pop"
        ],
        [
          {
            "$regex": "[\\/*]",
            "$flags": ""
          },
          "comment"
        ]
      ],
      "apexdoc": [
        [
          {
            "$regex": "[^\\/*]+",
            "$flags": ""
          },
          "comment.doc"
        ],
        [
          {
            "$regex": "\\*\\/",
            "$flags": ""
          },
          "comment.doc",
          "@pop"
        ],
        [
          {
            "$regex": "[\\/*]",
            "$flags": ""
          },
          "comment.doc"
        ]
      ],
      "string": [
        [
          {
            "$regex": "[^\\\\\"']+",
            "$flags": ""
          },
          "string"
        ],
        [
          {
            "$regex": "@escapes",
            "$flags": ""
          },
          "string.escape"
        ],
        [
          {
            "$regex": "\\\\.",
            "$flags": ""
          },
          "string.escape.invalid"
        ],
        [
          {
            "$regex": "[\"']",
            "$flags": ""
          },
          {
            "cases": {
              "$#==$S2": {
                "token": "string",
                "next": "@pop"
              },
              "@default": "string"
            }
          }
        ]
      ]
    }
