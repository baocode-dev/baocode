    "tokenizer": {
      "root": [
        {
          "include": "@comments"
        },
        {
          "include": "@whitespace"
        },
        {
          "include": "@numbers"
        },
        {
          "include": "@strings"
        },
        {
          "include": "@complexIdentifiers"
        },
        [
          {
            "$regex": "[;,.]",
            "$flags": ""
          },
          "delimiter"
        ],
        [
          {
            "$regex": "[({})]",
            "$flags": ""
          },
          "@brackets"
        ],
        [
          {
            "$regex": "[a-z_][a-zA-Z0-9_]*",
            "$flags": ""
          },
          {
            "cases": {
              "@keywords": "keyword",
              "@functions": "keyword",
              "@default": "identifier"
            }
          }
        ],
        [
          {
            "$regex": "[<>=!%&+\\-*/|~^]",
            "$flags": ""
          },
          "operator"
        ]
      ],
      "whitespace": [
        [
          {
            "$regex": "\\s+",
            "$flags": ""
          },
          "white"
        ]
      ],
      "comments": [
        [
          {
            "$regex": "\\/\\/+.*",
            "$flags": ""
          },
          "comment"
        ],
        [
          {
            "$regex": "\\/\\*",
            "$flags": ""
          },
          {
            "token": "comment.quote",
            "next": "@comment"
          }
        ]
      ],
      "comment": [
        [
          {
            "$regex": "[^*/]+",
            "$flags": ""
          },
          "comment"
        ],
        [
          {
            "$regex": "\\*\\/",
            "$flags": ""
          },
          {
            "token": "comment.quote",
            "next": "@pop"
          }
        ],
        [
          {
            "$regex": ".",
            "$flags": ""
          },
          "comment"
        ]
      ],
      "numbers": [
        [
          {
            "$regex": "0[xX][0-9a-fA-F]*",
            "$flags": ""
          },
          "number"
        ],
        [
          {
            "$regex": "[$][+-]*\\d*(\\.\\d*)?",
            "$flags": ""
          },
          "number"
        ],
        [
          {
            "$regex": "((\\d+(\\.\\d*)?)|(\\.\\d+))([eE][\\-+]?\\d+)?",
            "$flags": ""
          },
          "number"
        ]
      ],
      "strings": [
        [
          {
            "$regex": "N\"",
            "$flags": ""
          },
          {
            "token": "string",
            "next": "@string"
          }
        ],
        [
          {
            "$regex": "\"",
            "$flags": ""
          },
          {
            "token": "string",
            "next": "@string"
          }
        ]
      ],
      "string": [
        [
          {
            "$regex": "[^\"]+",
            "$flags": ""
          },
          "string"
        ],
        [
          {
            "$regex": "\"\"",
            "$flags": ""
          },
          "string"
        ],
        [
          {
            "$regex": "\"",
            "$flags": ""
          },
          {
            "token": "string",
            "next": "@pop"
          }
        ]
      ],
      "complexIdentifiers": [
        [
          {
            "$regex": "\\[",
            "$flags": ""
          },
          {
            "token": "identifier.quote",
            "next": "@bracketedIdentifier"
          }
        ],
        [
          {
            "$regex": "'",
            "$flags": ""
          },
          {
            "token": "identifier.quote",
            "next": "@quotedIdentifier"
          }
        ]
      ],
      "bracketedIdentifier": [
        [
          {
            "$regex": "[^\\]]+",
            "$flags": ""
          },
          "identifier"
        ],
        [
          {
            "$regex": "]]",
            "$flags": ""
          },
          "identifier"
        ],
        [
          {
            "$regex": "]",
            "$flags": ""
          },
          {
            "token": "identifier.quote",
            "next": "@pop"
          }
        ]
      ],
      "quotedIdentifier": [
        [
          {
            "$regex": "[^']+",
            "$flags": ""
          },
          "identifier"
        ],
        [
          {
            "$regex": "''",
            "$flags": ""
          },
          "identifier"
        ],
        [
          {
            "$regex": "'",
            "$flags": ""
          },
          {
            "token": "identifier.quote",
            "next": "@pop"
          }
        ]
      ]
    }
  },
  "configuration": {
    "comments": {
      "lineComment": "//",
      "blockComment": [
        "/*",
        "*/"
      ]
    },
    "brackets": [
      [
        "[",
        "]"
      ],
      [
        "(",
        ")"
      ],
      [
        "{",
        "}"
      ]
    ],
    "autoClosingPairs": [
      {
        "open": "\"",
        "close": "\"",
        "notIn": [
          "string",
          "comment"
        ]
      },
      {
        "open": "'",
        "close": "'",
        "notIn": [
          "string",
          "comment"
        ]
      },
      {
        "open": "[",
        "close": "]",
        "notIn": [
          "string",
          "comment"
        ]
      },
      {
        "open": "(",
        "close": ")",
        "notIn": [
          "string",
          "comment"
        ]
      },
      {
        "open": "{",
        "close": "}",
        "notIn": [
          "string",
          "comment"
        ]
      }
    ]
  }
}
