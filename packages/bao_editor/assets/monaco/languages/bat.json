{
  "revision": "d61824269f1377111d34306e4a47172327777083",
  "attribution": "Copyright (c) Microsoft Corporation. Licensed under the MIT License; see assets/monaco/LICENSE.txt.",
  "languageId": "bat",
  "language": {
    "defaultToken": "",
    "ignoreCase": true,
    "tokenPostfix": ".bat",
    "brackets": [
      {
        "token": "delimiter.bracket",
        "open": "{",
        "close": "}"
      },
      {
        "token": "delimiter.parenthesis",
        "open": "(",
        "close": ")"
      },
      {
        "token": "delimiter.square",
        "open": "[",
        "close": "]"
      }
    ],
    "keywords": {
      "$regex": "call|defined|echo|errorlevel|exist|for|goto|if|pause|set|shift|start|title|not|pushd|popd",
      "$flags": ""
    },
    "symbols": {
      "$regex": "[=><!~?&|+\\-*\\/\\^;\\.,]+",
      "$flags": ""
    },
    "escapes": {
      "$regex": "\\\\(?:[abfnrtv\\\\\"']|x[0-9A-Fa-f]{1,4}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})",
      "$flags": ""
    },
    "tokenizer": {
      "root": [
        [
          {
            "$regex": "^(\\s*)(rem(?:\\s.*|))$",
            "$flags": ""
          },
          [
            "",
            "comment"
          ]
        ],
        [
          {
            "$regex": "(\\@?)(@keywords)(?!\\w)",
            "$flags": ""
          },
          [
            {
              "token": "keyword"
            },
            {
              "token": "keyword.$2"
            }
          ]
        ],
        [
          {
            "$regex": "[ \\t\\r\\n]+",
            "$flags": ""
          },
          ""
        ],
        [
          {
            "$regex": "setlocal(?!\\w)",
            "$flags": ""
          },
          "keyword.tag-setlocal"
        ],
        [
          {
            "$regex": "endlocal(?!\\w)",
            "$flags": ""
          },
          "keyword.tag-setlocal"
        ],
        [
          {
            "$regex": "[a-zA-Z_]\\w*",
            "$flags": ""
          },
          ""
        ],
        [
          {
            "$regex": ":\\w*",
            "$flags": ""
          },
          "metatag"
        ],
        [
          {
            "$regex": "%[^%]+%",
            "$flags": ""
          },
          "variable"
        ],
        [
          {
            "$regex": "%%[\\w]+(?!\\w)",
            "$flags": ""
          },
          "variable"
        ],
        [
          {
            "$regex": "[{}()\\[\\]]",
            "$flags": ""
          },
          "@brackets"
        ],
        [
          {
            "$regex": "@symbols",
            "$flags": ""
          },
          "delimiter"
        ],
        [
          {
            "$regex": "\\d*\\.\\d+([eE][\\-+]?\\d+)?",
            "$flags": ""
          },
          "number.float"
        ],
        [
          {
            "$regex": "0[xX][0-9a-fA-F_]*[0-9a-fA-F]",
            "$flags": ""
          },
          "number.hex"
        ],
        [
          {
            "$regex": "\\d+",
            "$flags": ""
          },
          "number"
        ],
        [
          {
            "$regex": "[;,.]",
            "$flags": ""
          },
          "delimiter"
        ],
        [
          {
            "$regex": "\"",
            "$flags": ""
          },
          "string",
          "@string.\""
        ],
        [
          {
            "$regex": "'",
            "$flags": ""
          },
          "string",
          "@string.'"
        ]
      ],
      "string": [
        [
          {
            "$regex": "[^\\\\\"'%]+",
            "$flags": ""
          },
          {
            "cases": {
              "@eos": {
                "token": "string",
                "next": "@popall"
              },
              "@default": "string"
            }
          }
        ],
        [
          {
            "$regex": "@escapes",
            "$flags": ""
          },
          "string.escape"
        ],
        [
          {
            "$regex": "\\\\.",
            "$flags": ""
          },
          "string.escape.invalid"
        ],
        [
          {
            "$regex": "%[\\w ]+%",
            "$flags": ""
          },
          "variable"
        ],
        [
          {
            "$regex": "%%[\\w]+(?!\\w)",
            "$flags": ""
          },
          "variable"
        ],
        [
          {
            "$regex": "[\"']",
            "$flags": ""
          },
          {
            "cases": {
              "$#==$S2": {
                "token": "string",
                "next": "@pop"
              },
              "@default": "string"
            }
          }
        ],
        [
          {
            "$regex": "$",
            "$flags": ""
          },
          "string",
          "@popall"
        ]
      ]
    }
  },
  "configuration": {
    "comments": {
      "lineComment": "REM"
    },
    "brackets": [
      [
        "{",
        "}"
      ],
      [
        "[",
        "]"
      ],
      [
        "(",
        ")"
      ]
    ],
    "autoClosingPairs": [
      {
        "open": "{",
        "close": "}"
      },
      {
        "open": "[",
        "close": "]"
      },
      {
        "open": "(",
        "close": ")"
      },
      {
        "open": "\"",
        "close": "\""
      }
    ],
    "surroundingPairs": [
      {
        "open": "[",
        "close": "]"
      },
      {
        "open": "(",
        "close": ")"
      },
      {
        "open": "\"",
        "close": "\""
      }
    ],
    "folding": {
      "markers": {
        "start": {
          "$regex": "^\\s*(::\\s*|REM\\s+)#region",
          "$flags": ""
        },
        "end": {
          "$regex": "^\\s*(::\\s*|REM\\s+)#endregion",
          "$flags": ""
        }
      }
    }
  }
}
