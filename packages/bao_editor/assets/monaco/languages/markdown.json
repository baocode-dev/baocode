          }
        ],
        [
          {
            "$regex": "<\\/(\\w+)(\\-|\\w)*\\s*>",
            "$flags": ""
          },
          {
            "token": "tag"
          }
        ],
        [
          {
            "$regex": "<!--",
            "$flags": ""
          },
          "comment",
          "@comment"
        ]
      ],
      "comment": [
        [
          {
            "$regex": "[^<\\-]+",
            "$flags": ""
          },
          "comment.content"
        ],
        [
          {
            "$regex": "-->",
            "$flags": ""
          },
          "comment",
          "@pop"
        ],
        [
          {
            "$regex": "<!--",
            "$flags": ""
          },
          "comment.content.invalid"
        ],
        [
          {
            "$regex": "[<\\-]",
            "$flags": ""
          },
          "comment.content"
        ]
      ],
      "tag": [
        [
          {
            "$regex": "[ \\t\\r\\n]+",
            "$flags": ""
          },
          "white"
        ],
        [
          {
            "$regex": "(type)(\\s*=\\s*)(\")([^\"]+)(\")",
            "$flags": ""
          },
          [
            "attribute.name.html",
            "delimiter.html",
            "string.html",
            {
              "token": "string.html",
              "switchTo": "@tag.$S2.$4"
            },
            "string.html"
          ]
        ],
        [
          {
            "$regex": "(type)(\\s*=\\s*)(')([^']+)(')",
            "$flags": ""
          },
          [
            "attribute.name.html",
            "delimiter.html",
            "string.html",
            {
              "token": "string.html",
              "switchTo": "@tag.$S2.$4"
            },
            "string.html"
          ]
        ],
        [
          {
            "$regex": "(\\w+)(\\s*=\\s*)(\"[^\"]*\"|'[^']*')",
            "$flags": ""
          },
          [
            "attribute.name.html",
            "delimiter.html",
            "string.html"
          ]
        ],
        [
          {
            "$regex": "\\w+",
            "$flags": ""
          },
          "attribute.name.html"
        ],
        [
          {
            "$regex": "\\/>",
            "$flags": ""
          },
          "tag",
          "@pop"
        ],
        [
          {
            "$regex": ">",
            "$flags": ""
          },
          {
            "cases": {
              "$S2==style": {
                "token": "tag",
                "switchTo": "embeddedStyle",
                "nextEmbedded": "text/css"
              },
              "$S2==script": {
                "cases": {
                  "$S3": {
                    "token": "tag",
                    "switchTo": "embeddedScript",
                    "nextEmbedded": "$S3"
                  },
                  "@default": {
                    "token": "tag",
                    "switchTo": "embeddedScript",
                    "nextEmbedded": "text/javascript"
                  }
                }
              },
              "@default": {
                "token": "tag",
                "next": "@pop"
              }
            }
          }
        ]
