        [
          {
            "$regex": "^(\\s{0,3})(#+)((?:[^\\\\#]|@escapes)+)((?:#+)?)",
            "$flags": ""
          },
          [
            "white",
            "keyword",
            "keyword",
            "keyword"
          ]
        ],
        [
          {
            "$regex": "^\\s*(=+|\\-+)\\s*$",
            "$flags": ""
          },
          "keyword"
        ],
        [
