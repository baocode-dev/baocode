            "$regex": "@escapes",
            "$flags": ""
          },
          "escape"
        ],
        [
          {
            "$regex": "\\b__([^\\\\_]|@escapes|_(?!_))+__\\b",
            "$flags": ""
          },
          "strong"
        ],
        [
          {
            "$regex": "\\*\\*([^\\\\*]|@escapes|\\*(?!\\*))+\\*\\*",
            "$flags": ""
          },
          "strong"
        ],
        [
          {
            "$regex": "\\b_[^_]+_\\b",
            "$flags": ""
          },
          "emphasis"
        ],
        [
          {
            "$regex": "\\*([^\\\\*]|@escapes)+\\*",
            "$flags": ""
          },
          "emphasis"
        ],
        [
          {
            "$regex": "`([^\\\\`]|@escapes)+`",
            "$flags": ""
          },
          "variable"
        ],
        [
          {
            "$regex": "\\{+[^}]+\\}+",
            "$flags": ""
          },
          "string.target"
        ],
        [
          {
            "$regex": "(!?\\[)((?:[^\\]\\\\]|@escapes)*)(\\]\\([^\\)]+\\))",
            "$flags": ""
          },
          [
            "string.link",
            "",
            "string.link"
          ]
        ],
        [
          {
            "$regex": "(!?\\[)((?:[^\\]\\\\]|@escapes)*)(\\])",
            "$flags": ""
          },
          "string.link"
