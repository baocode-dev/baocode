  "languageId": "sparql",
  "language": {
    "defaultToken": "",
    "tokenPostfix": ".rq",
    "brackets": [
      {
        "token": "delimiter.curly",
        "open": "{",
        "close": "}"
      },
      {
        "token": "delimiter.parenthesis",
        "open": "(",
        "close": ")"
      },
      {
        "token": "delimiter.square",
        "open": "[",
        "close": "]"
      },
      {
        "token": "delimiter.angle",
        "open": "<",
        "close": ">"
      }
    ],
    "keywords": [
      "add",
      "as",
      "asc",
      "ask",
      "base",
      "by",
      "clear",
      "construct",
      "copy",
      "create",
      "data",
