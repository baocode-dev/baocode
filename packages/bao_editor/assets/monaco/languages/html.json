    "onEnterRules": [
      {
        "beforeText": {
          "$regex": "<(?!(?:area|base|br|col|embed|hr|img|input|keygen|link|menuitem|meta|param|source|track|wbr))([_:\\w][_:\\w-.\\d]*)([^/>]*(?!\\/)>)[^<]*$",
          "$flags": "i"
        },
        "afterText": {
          "$regex": "^<\\/([_:\\w][_:\\w-.\\d]*)\\s*>$",
          "$flags": "i"
        },
        "action": {
          "indentAction": 2
        }
      },
      {
        "beforeText": {
          "$regex": "<(?!(?:area|base|br|col|embed|hr|img|input|keygen|link|menuitem|meta|param|source|track|wbr))(\\w[\\w\\d]*)([^/>]*(?!\\/)>)[^<]*$",
          "$flags": "i"
