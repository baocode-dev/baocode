          "constant"
        ]
      ],
      "regexpContentInterpol": [
        {
          "include": "@interpolation"
        },
        {
          "include": "@escapeChar"
        },
        {
          "include": "@regexpContent"
        }
      ],
      "regexpContent": [
        [
          {
            "$regex": "(\\s)(#)(\\s.*)$",
            "$flags": ""
          },
          [
            "white",
            "comment.punctuation",
            "comment"
          ]
        ],
        [
          {
            "$regex": ".",
            "$flags": ""
          },
          "regexp"
        ]
      ],
      "sigilContentInterpol": [
        {
          "include": "@interpolation"
        },
        {
          "include": "@escapeChar"
        },
        {
          "include": "@sigilContent"
        }
      ],
      "sigilContent": [
        [
          {
            "$regex": ".",
            "$flags": ""
          },
          "sigil"
        ]
      ],
      "docstringContent": [
        [
          {
            "$regex": ".",
            "$flags": ""
          },
          "comment.block.documentation"
        ]
      ],
      "escapeChar": [
        [
          {
            "$regex": "@escape",
            "$flags": ""
          },
          "constant.character.escape"
        ]
      ],
      "interpolation": [
        [
          {
            "$regex": "#{",
            "$flags": ""
          },
          {
            "token": "delimiter.bracket.embed",
            "next": "@interpolationContinue"
          }
        ]
      ],
      "interpolationContinue": [
        [
          {
            "$regex": "}",
            "$flags": ""
          },
          {
            "token": "delimiter.bracket.embed",
            "next": "@pop"
          }
        ],
        {
          "include": "@root"
        }
      ]
    }
  },
  "configuration": {
    "comments": {
      "lineComment": "#"
    },
    "brackets": [
      [
        "{",
        "}"
      ],
      [
        "[",
        "]"
      ],
      [
        "(",
        ")"
      ]
    ],
    "surroundingPairs": [
      {
        "open": "{",
        "close": "}"
      },
      {
        "open": "[",
        "close": "]"
      },
      {
        "open": "(",
        "close": ")"
      },
      {
        "open": "'",
        "close": "'"
      },
      {
        "open": "\"",
        "close": "\""
      }
    ],
    "autoClosingPairs": [
      {
        "open": "'",
        "close": "'",
        "notIn": [
          "string",
          "comment"
        ]
      },
      {
        "open": "\"",
        "close": "\"",
        "notIn": [
          "comment"
        ]
      },
      {
        "open": "\"\"\"",
        "close": "\"\"\""
      },
      {
        "open": "`",
        "close": "`",
        "notIn": [
          "string",
          "comment"
        ]
      },
      {
        "open": "(",
        "close": ")"
      },
      {
        "open": "{",
        "close": "}"
      },
      {
        "open": "[",
        "close": "]"
      },
      {
        "open": "<<",
        "close": ">>"
      }
    ],
    "indentationRules": {
      "increaseIndentPattern": {
        "$regex": "^\\s*(after|else|catch|rescue|fn|[^#]*(do|<\\-|\\->|\\{|\\[|\\=))\\s*$",
        "$flags": ""
      },
      "decreaseIndentPattern": {
        "$regex": "^\\s*((\\}|\\])\\s*$|(after|else|catch|rescue|end)\\b)",
        "$flags": ""
      }
    }
  }
