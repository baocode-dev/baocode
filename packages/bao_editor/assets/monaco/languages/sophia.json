{
  "revision": "d61824269f1377111d34306e4a47172327777083",
  "attribution": "Copyright (c) Microsoft Corporation. Licensed under the MIT License; see assets/monaco/LICENSE.txt.",
  "languageId": "sophia",
  "language": {
    "defaultToken": "",
    "tokenPostfix": ".aes",
    "brackets": [
      {
        "token": "delimiter.curly",
        "open": "{",
        "close": "}"
      },
      {
        "token": "delimiter.parenthesis",
        "open": "(",
        "close": ")"
      },
      {
        "token": "delimiter.square",
        "open": "[",
        "close": "]"
      },
      {
        "token": "delimiter.angle",
        "open": "<",
        "close": ">"
      }
    ],
    "keywords": [
      "contract",
      "library",
      "entrypoint",
      "function",
      "stateful",
      "state",
      "hash",
      "signature",
      "tuple",
      "list",
      "address",
      "string",
      "bool",
      "int",
      "record",
      "datatype",
      "type",
      "option",
      "oracle",
      "oracle_query",
      "Call",
      "Bits",
      "Bytes",
      "Oracle",
      "String",
      "Crypto",
      "Address",
      "Auth",
      "Chain",
      "None",
      "Some",
      "bits",
      "bytes",
      "event",
      "let",
      "map",
      "private",
      "public",
      "true",
      "false",
      "var",
      "if",
      "else",
      "throw"
    ],
    "operators": [
      "=",
      ">",
      "<",
      "!",
      "~",
      "?",
      "::",
      ":",
      "==",
      "<=",
      ">=",
      "!=",
      "&&",
      "||",
      "++",
      "--",
      "+",
      "-",
      "*",
      "/",
      "&",
      "|",
      "^",
      "%",
      "<<",
      ">>",
      ">>>",
      "+=",
      "-=",
      "*=",
      "/=",
      "&=",
      "|=",
      "^=",
      "%=",
      "<<=",
      ">>=",
      ">>>="
    ],
    "symbols": {
      "$regex": "[=><!~?:&|+\\-*\\/\\^%]+",
      "$flags": ""
    },
    "escapes": {
      "$regex": "\\\\(?:[abfnrtv\\\\\"']|x[0-9A-Fa-f]{1,4}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})",
      "$flags": ""
    },
    "integersuffix": {
      "$regex": "(ll|LL|u|U|l|L)?(ll|LL|u|U|l|L)?",
      "$flags": ""
    },
    "floatsuffix": {
      "$regex": "[fFlL]?",
      "$flags": ""
    },
    "tokenizer": {
      "root": [
        [
          {
            "$regex": "[a-zA-Z_]\\w*",
            "$flags": ""
          },
          {
            "cases": {
              "@keywords": {
                "token": "keyword.$0"
              },
              "@default": "identifier"
            }
          }
        ],
        {
          "include": "@whitespace"
        },
        [
          {
            "$regex": "\\[\\[.*\\]\\]",
            "$flags": ""
          },
          "annotation"
        ],
        [
          {
            "$regex": "^\\s*#\\w+",
            "$flags": ""
          },
          "keyword"
        ],
        [
          {
            "$regex": "int\\d*",
            "$flags": ""
          },
          "keyword"
        ],
        [
          {
            "$regex": "[{}()\\[\\]]",
            "$flags": ""
          },
          "@brackets"
        ],
        [
          {
            "$regex": "[<>](?!@symbols)",
            "$flags": ""
          },
          "@brackets"
        ],
        [
          {
            "$regex": "@symbols",
            "$flags": ""
          },
          {
            "cases": {
              "@operators": "delimiter",
              "@default": ""
            }
          }
        ],
        [
          {
            "$regex": "\\d*\\d+[eE]([\\-+]?\\d+)?(@floatsuffix)",
            "$flags": ""
          },
          "number.float"
        ],
        [
          {
            "$regex": "\\d*\\.\\d+([eE][\\-+]?\\d+)?(@floatsuffix)",
            "$flags": ""
          },
          "number.float"
        ],
        [
          {
            "$regex": "0[xX][0-9a-fA-F']*[0-9a-fA-F](@integersuffix)",
            "$flags": ""
          },
          "number.hex"
        ],
        [
          {
            "$regex": "0[0-7']*[0-7](@integersuffix)",
            "$flags": ""
          },
          "number.octal"
        ],
        [
          {
            "$regex": "0[bB][0-1']*[0-1](@integersuffix)",
            "$flags": ""
          },
          "number.binary"
        ],
        [
          {
            "$regex": "\\d[\\d']*\\d(@integersuffix)",
            "$flags": ""
          },
          "number"
        ],
        [
          {
            "$regex": "\\d(@integersuffix)",
            "$flags": ""
          },
          "number"
        ],
        [
          {
            "$regex": "[;,.]",
            "$flags": ""
          },
          "delimiter"
        ],
        [
          {
            "$regex": "\"([^\"\\\\]|\\\\.)*$",
            "$flags": ""
          },
          "string.invalid"
        ],
        [
          {
            "$regex": "\"",
            "$flags": ""
          },
          "string",
          "@string"
        ],
        [
          {
            "$regex": "'[^\\\\']'",
            "$flags": ""
          },
          "string"
        ],
        [
          {
            "$regex": "(')(@escapes)(')",
            "$flags": ""
          },
          [
            "string",
            "string.escape",
            "string"
          ]
        ],
        [
          {
            "$regex": "'",
            "$flags": ""
          },
          "string.invalid"
        ]
      ],
      "whitespace": [
        [
          {
            "$regex": "[ \\t\\r\\n]+",
            "$flags": ""
          },
          ""
        ],
        [
          {
            "$regex": "\\/\\*\\*(?!\\/)",
            "$flags": ""
          },
          "comment.doc",
          "@doccomment"
        ],
        [
          {
            "$regex": "\\/\\*",
            "$flags": ""
          },
          "comment",
          "@comment"
        ],
        [
          {
            "$regex": "\\/\\/.*$",
            "$flags": ""
          },
          "comment"
        ]
      ],
      "comment": [
        [
          {
            "$regex": "[^\\/*]+",
            "$flags": ""
          },
          "comment"
        ],
        [
          {
            "$regex": "\\*\\/",
            "$flags": ""
          },
          "comment",
          "@pop"
        ],
        [
          {
            "$regex": "[\\/*]",
            "$flags": ""
          },
          "comment"
        ]
      ],
      "doccomment": [
        [
          {
            "$regex": "[^\\/*]+",
            "$flags": ""
          },
          "comment.doc"
        ],
        [
          {
            "$regex": "\\*\\/",
            "$flags": ""
          },
          "comment.doc",
          "@pop"
        ],
        [
          {
            "$regex": "[\\/*]",
            "$flags": ""
          },
          "comment.doc"
        ]
      ],
      "string": [
        [
          {
            "$regex": "[^\\\\\"]+",
            "$flags": ""
          },
          "string"
        ],
        [
          {
            "$regex": "@escapes",
            "$flags": ""
          },
          "string.escape"
        ],
        [
          {
            "$regex": "\\\\.",
            "$flags": ""
          },
          "string.escape.invalid"
        ],
        [
          {
            "$regex": "\"",
            "$flags": ""
          },
          "string",
          "@pop"
        ]
      ]
    }
  },
  "configuration": {
    "comments": {
      "lineComment": "//",
      "blockComment": [
        "/*",
        "*/"
      ]
    },
    "brackets": [
      [
        "{",
        "}"
      ],
      [
        "[",
        "]"
      ],
      [
        "(",
        ")"
      ],
      [
        "<",
        ">"
      ]
    ],
    "autoClosingPairs": [
      {
        "open": "\"",
        "close": "\"",
        "notIn": [
          "string",
          "comment"
        ]
      },
      {
        "open": "{",
        "close": "}",
        "notIn": [
          "string",
          "comment"
        ]
      },
      {
        "open": "[",
        "close": "]",
        "notIn": [
          "string",
          "comment"
        ]
      },
      {
        "open": "(",
        "close": ")",
        "notIn": [
          "string",
          "comment"
        ]
      }
    ]
  }
}
