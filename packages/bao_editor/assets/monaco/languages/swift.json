        [
          {
            "$regex": ".",
            "$flags": ""
          },
          "comment.doc"
        ]
      ],
      "commentbody": [
        [
          {
            "$regex": "\\/\\*",
            "$flags": ""
          },
          "comment",
          "@commentbody"
        ],
        [
          {
            "$regex": "\\*\\/",
            "$flags": ""
          },
          "comment",
          "@pop"
        ],
        [
          {
            "$regex": ".",
            "$flags": ""
          },
          "comment"
        ]
      ],
      "attribute": [
        [
          {
            "$regex": "@@@identifier",
            "$flags": ""
          },
          {
            "cases": {
              "@attributes": "keyword.control",
              "@default": ""
            }
          }
        ]
      ],
      "literal": [
        [
          {
            "$regex": "\"",
            "$flags": ""
          },
          {
            "token": "string.quote",
            "next": "@stringlit"
          }
        ],
        [
          {
            "$regex": "0[b]([01]_?)+",
            "$flags": ""
          },
          "number.binary"
        ],
        [
          {
            "$regex": "0[o]([0-7]_?)+",
            "$flags": ""
          },
          "number.octal"
        ],
        [
          {
            "$regex": "0[x]([0-9a-fA-F]_?)+([pP][\\-+](\\d_?)+)?",
            "$flags": ""
          },
          "number.hex"
        ],
        [
          {
            "$regex": "(\\d_?)*\\.(\\d_?)+([eE][\\-+]?(\\d_?)+)?",
            "$flags": ""
          },
          "number.float"
        ],
        [
          {
            "$regex": "(\\d_?)+",
            "$flags": ""
          },
          "number"
        ]
      ],
      "stringlit": [
        [
          {
            "$regex": "\\\\\\(",
            "$flags": ""
          },
          {
            "token": "operator",
            "next": "@interpolatedexpression"
          }
        ],
        [
          {
            "$regex": "@escapes",
            "$flags": ""
          },
          "string"
        ],
        [
          {
            "$regex": "\\\\.",
            "$flags": ""
          },
          "string.escape.invalid"
        ],
        [
          {
            "$regex": "\"",
            "$flags": ""
          },
          {
            "token": "string.quote",
            "next": "@pop"
          }
        ],
        [
          {
            "$regex": ".",
            "$flags": ""
          },
          "string"
        ]
      ],
      "interpolatedexpression": [
        [
          {
            "$regex": "\\(",
            "$flags": ""
          },
          {
            "token": "operator",
            "next": "@interpolatedexpression"
          }
        ],
        [
          {
            "$regex": "\\)",
            "$flags": ""
          },
          {
            "token": "operator",
            "next": "@pop"
          }
        ],
        {
          "include": "@literal"
        },
        {
          "include": "@keyword"
        },
        {
          "include": "@symbol"
        }
      ],
      "keyword": [
        [
          {
            "$regex": "`",
            "$flags": ""
          },
          {
            "token": "operator",
            "next": "@escapedkeyword"
          }
        ],
        [
          {
            "$regex": "@identifier",
            "$flags": ""
          },
          {
            "cases": {
              "@keywords": "keyword",
              "[A-Z][a-zA-Z0-9$]*": "type.identifier",
              "@default": "identifier"
            }
          }
        ]
      ],
      "escapedkeyword": [
        [
          {
            "$regex": "`",
            "$flags": ""
          },
          {
            "token": "operator",
            "next": "@pop"
          }
        ],
        [
          {
            "$regex": ".",
            "$flags": ""
          },
          "identifier"
        ]
      ],
      "invokedmethod": [
        [
          {
            "$regex": "([.])(@identifier)",
            "$flags": ""
          },
          {
            "cases": {
              "$2": [
                "delimeter",
                "type.identifier"
              ],
              "@default": ""
            }
          }
        ]
      ]
