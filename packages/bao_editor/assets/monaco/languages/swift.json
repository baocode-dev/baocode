            "$flags": ""
          },
          "comment.doc",
          "@commentdocbody"
        ],
        [
          {
            "$regex": "\\/\\/.*$",
            "$flags": ""
          },
          "comment"
        ],
        [
          {
            "$regex": "\\/\\*",
            "$flags": ""
          },
          "comment",
          "@commentbody"
        ]
      ],
      "commentdocbody": [
