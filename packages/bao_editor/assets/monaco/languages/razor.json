  "configuration": {
    "wordPattern": {
      "$regex": "(-?\\d*\\.\\d\\w*)|([^\\`\\~\\!\\@\\$\\^\\&\\*\\(\\)\\-\\=\\+\\[\\{\\]\\}\\\\\\|\\;\\:\\'\\\"\\,\\.\\<\\>\\/\\s]+)",
      "$flags": "g"
    },
    "comments": {
      "blockComment": [
        "<!--",
        "-->"
      ]
    },
    "brackets": [
      [
        "<!--",
        "-->"
      ],
      [
        "<",
        ">"
      ],
      [
        "{",
        "}"
      ],
      [
        "(",
        ")"
      ]
    ],
    "autoClosingPairs": [
      {
        "open": "{",
        "close": "}"
      },
      {
        "open": "[",
        "close": "]"
      },
      {
        "open": "(",
        "close": ")"
      },
      {
        "open": "\"",
        "close": "\""
      },
      {
        "open": "'",
        "close": "'"
      }
    ],
    "surroundingPairs": [
      {
        "open": "\"",
        "close": "\""
      },
      {
        "open": "'",
        "close": "'"
      },
      {
        "open": "<",
        "close": ">"
      }
    ],
    "onEnterRules": [
      {
        "beforeText": {
          "$regex": "<(?!(?:area|base|br|col|embed|hr|img|input|keygen|link|menuitem|meta|param|source|track|wbr))(\\w[\\w\\d]*)([^/>]*(?!\\/)>)[^<]*$",
          "$flags": "i"
        },
        "afterText": {
          "$regex": "^<\\/(\\w[\\w\\d]*)\\s*>$",
          "$flags": "i"
        },
        "action": {
          "indentAction": 2
        }
      },
      {
        "beforeText": {
          "$regex": "<(?!(?:area|base|br|col|embed|hr|img|input|keygen|link|menuitem|meta|param|source|track|wbr))(\\w[\\w\\d]*)([^/>]*(?!\\/)>)[^<]*$",
