# Response headers for Cloudflare Pages
# (https://developers.cloudflare.com/pages/configuration/headers/).

# Inline style attributes only for /upstreams' sample buttons, which carry
# their own style to be copied. Cloudflare Web Analytics puts its beacon in
# each page on the way out: its script, and where it reports. Any site may
# show the pages in a frame, but for /import and /activate (below).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self'; media-src 'self'; connect-src 'self' https://dl.baocode.dev https://stats.baocode.dev https://cloudflareinsights.com; frame-ancestors *; base-uri 'self'; form-action 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# Screenshots, the sound and the icon change rarely and keep their names:
# cached a day, and served from cache for a week more while refetched.
/shots/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/sounds/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/icon.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# BaoCode's icons, loaded by upstreams' key pages (/upstreams): from any
# site, kept a day as the rest.
/brand/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin

# The windows drawn for the pages' figures: framed by them, not pages of
# their own.
/mocks/*
  Cache-Control: public, max-age=300
  X-Robots-Tag: noindex

# The upstreams Settings → Models lists, and their logos
# (lib/models/featured_upstreams.dart): a site listed shows within minutes.
/featured/*
  Cache-Control: public, max-age=300

# The channels' editions (site.js): a change shows
# within minutes.
/channels.json
  Cache-Control: public, max-age=300

# Not part of the site.
/README.md
  X-Robots-Tag: noindex

# The one-click import (import.js): what it reads is the visitor's own.
# Never in another site's frame, to be clicked through unseen: a second
# policy, enforced with the first.
/import
  Cache-Control: no-store
  X-Robots-Tag: noindex
  Content-Security-Policy: frame-ancestors 'none'
/zh/import
  Cache-Control: no-store
  X-Robots-Tag: noindex
  Content-Security-Policy: frame-ancestors 'none'

# The channel build's first start (activate.js); not in a frame either.
/activate
  Cache-Control: no-store
  X-Robots-Tag: noindex
  Content-Security-Policy: frame-ancestors 'none'
/zh/activate
  Cache-Control: no-store
  X-Robots-Tag: noindex
  Content-Security-Policy: frame-ancestors 'none'
